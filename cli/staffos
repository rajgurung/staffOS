#!/usr/bin/env ruby
# frozen_string_literal: true

require "net/http"
require "json"
require "uri"
require "yaml"
require "fileutils"

class StaffOSCLI
  CONFIG_FILE = ".staffos.yml"
  CREDENTIALS_FILE = File.expand_path("~/.staffos/credentials.yml")
  VERSION = "0.5.0"

  def initialize(args)
    @args = args
    @command = args.first
  end

  def run
    case @command
    when "login"      then login
    when "init"       then init_project
    when "status"     then status
    when "passport"   then passport
    when "disconnect" then disconnect
    when "hook"       then generate_hook
    when "capture"    then capture(@args[1])
    when "version"    then puts "staffos #{VERSION}"
    when "help", "-h", "--help", nil then help
    else
      puts "Unknown command: #{@command}"
      help
      exit 1
    end
  end

  private

  # ── Commands ──

  def login
    print "StaffOS API endpoint [http://localhost:9090]: "
    endpoint = $stdin.gets.strip
    endpoint = "http://localhost:9090" if endpoint.empty?

    print "API token: "
    token = $stdin.gets.strip

    if token.empty?
      puts "Error: API token is required."
      exit 1
    end

    endpoint = endpoint.sub(%r{/+\z}, "")

    # Verify connection
    begin
      uri = URI("#{endpoint}/up")
      res = Net::HTTP.get_response(uri)
      if res.code == "200"
        save_credentials(endpoint: endpoint, token: token)
        puts "Logged in to #{endpoint}"
      else
        puts "Connection failed (HTTP #{res.code})."
        exit 1
      end
    rescue => e
      puts "Connection failed: #{e.message}"
      exit 1
    end
  end

  def init_project
    if File.exist?(CONFIG_FILE)
      puts "Project already initialized (#{CONFIG_FILE} exists)."
      config = YAML.load_file(CONFIG_FILE)
      puts "  Project: #{config['project_name']}"
      puts "  Endpoint: #{config['api_endpoint']}"
      if config["api_token"]
        puts "  Token:    project-specific"
      else
        puts "  Token:    global login (add api_token to #{CONFIG_FILE} to pin this repo to its project)"
      end
      puts "\nRun 'staffos hook' to reinstall the Claude Code hooks."
      return
    end

    # A global login is optional: the project token is what routes events, so
    # init only needs the endpoint, which it asks for when there's no login.
    creds = load_credentials
    endpoint = creds && creds["endpoint"]
    unless endpoint
      print "StaffOS endpoint (shown on the Connect page): "
      endpoint = $stdin.gets.to_s.strip.sub(%r{/+\z}, "")
      if endpoint.empty?
        puts "Error: endpoint is required."
        exit 1
      end
    end

    project_name = detect_project_name
    repo_name = detect_repo_name

    print "Project name [#{project_name}]: "
    input = $stdin.gets.strip
    project_name = input unless input.empty?

    # API tokens belong to exactly one StaffOS project, and the server files
    # captured events under the token's project. Storing the token per-repo
    # keeps each repo routing to its own project even after a global re-login.
    puts "\nEach StaffOS project has its own API token (find it on the project's Connect page)."
    print creds ? "API token for this project [reuse global login token]: " : "API token for this project: "
    project_token = $stdin.gets.to_s.strip
    if project_token.empty? && !creds
      puts "Error: API token is required."
      exit 1
    end

    config = {
      "project_name" => project_name,
      "repo_name" => repo_name,
      "api_endpoint" => endpoint,
      "privacy" => {
        "upload_source" => false,
        "upload_diffs" => "metadata_only",
        "redact_secrets" => true
      }
    }
    config["api_token"] = project_token unless project_token.empty?

    File.write(CONFIG_FILE, config.to_yaml)
    File.chmod(0600, CONFIG_FILE) if config["api_token"]
    puts "Created #{CONFIG_FILE}"

    ignore_in_git(CONFIG_FILE)

    generate_hook
    puts "\nProject initialized. Start Claude Code and events will be captured."
  end

  def status
    config = load_config
    creds = capture_credentials

    puts "StaffOS Status"
    puts "─" * 40
    puts "Version:     #{VERSION}"
    puts "Project:     #{config ? config['project_name'] : 'Not initialized'}"
    puts "Repo:        #{config ? config['repo_name'] : 'N/A'}"
    puts "Branch:      #{current_branch}"
    puts "Endpoint:    #{creds ? creds['endpoint'] : 'Not set'}"
    puts "Config:      #{File.exist?(CONFIG_FILE) ? CONFIG_FILE : 'Not found'}"
    puts "Credentials: #{File.exist?(CREDENTIALS_FILE) ? 'Saved' : 'Not found'}"
    puts "Token:       #{config && config['api_token'] ? "project-specific (#{CONFIG_FILE})" : 'global login'}"

    hook_count = staffos_hook_events(HOOKS_FILE).length
    puts "Hooks:       #{hook_count > 0 ? "#{hook_count} events configured (#{HOOKS_FILE})" : 'Not configured'}"
    if staffos_hook_events(SHARED_HOOKS_FILE).any?
      puts "             Old hooks found in #{SHARED_HOOKS_FILE}. Run 'staffos hook' to move them."
    end

    if creds
      print "\nConnection:  Testing... "
      uri = URI("#{creds['endpoint']}/up")
      begin
        res = Net::HTTP.get_response(uri)
        puts res.code == "200" ? "OK" : "Failed (#{res.code})"
      rescue => e
        puts "Failed (#{e.message})"
      end
    end
  end

  def passport
    creds = capture_credentials
    unless creds
      puts "Not initialized. Run 'staffos init' in this repo."
      exit 1
    end

    branch = current_branch
    uri = URI("#{creds['endpoint']}/api/v1/passport")
    uri.query = URI.encode_www_form(branch: branch)
    begin
      http = Net::HTTP.new(uri.host, uri.port)
      http.use_ssl = uri.scheme == "https"
      http.open_timeout = 5
      http.read_timeout = 10
      req = Net::HTTP::Get.new(uri)
      req["Authorization"] = "Bearer #{creds['token']}"
      res = http.request(req)
    rescue => e
      puts "Could not reach StaffOS: #{e.message}"
      exit 1
    end

    case res.code
    when "200"
      print_passport(JSON.parse(res.body))
    when "404"
      puts "No passport for #{branch} yet."
      puts "One is built when Claude Code finishes a reply on this branch with the hooks installed."
    when "401"
      puts "StaffOS rejected the API token. Check api_token in #{CONFIG_FILE}."
      exit 1
    else
      puts "StaffOS returned HTTP #{res.code}."
      exit 1
    end
  end

  def print_passport(p)
    review = p["human_review_required"] ? " (human review required)" : ""
    puts "Passport: #{p['branch']} (#{p['project']})"
    puts "─" * 40
    puts "Readiness: #{p['readiness_score']}%"
    puts "Risk:      #{p['risk_level']}#{review}"
    puts "Tests:     #{p['test_status']}"
    puts "Sessions:  #{p['sessions_count']}   Files: #{p['files_count']}"
    puts "Updated:   #{p['updated_at']}"

    if Array(p["missing_checks"]).any?
      puts "\nNeeds attention:"
      Array(p["missing_checks"]).each { |c| puts "  [#{c['severity']}] #{c['check']}" }
    end
    if Array(p["recommended_actions"]).any?
      puts "\nNext steps:"
      Array(p["recommended_actions"]).each { |a| puts "  [#{a['priority']}] #{a['action']}" }
    end
    puts "\nOpen: #{p['url']}"
  end

  def disconnect
    removed = []

    if File.exist?(CREDENTIALS_FILE)
      File.delete(CREDENTIALS_FILE)
      removed << "credentials (#{CREDENTIALS_FILE})"
    end

    [HOOKS_FILE, SHARED_HOOKS_FILE].each do |file|
      removed << "Claude Code hooks (#{file})" if strip_staffos_hooks(file)
    end

    if removed.empty?
      puts "Nothing to disconnect — no StaffOS credentials or hooks found."
    else
      puts "Disconnected from StaffOS. Removed:"
      removed.each { |item| puts "  - #{item}" }
      puts "\nYour project config (#{CONFIG_FILE}) was left in place. Delete it manually to fully reset."
    end
  end

  # Claude Code hook events → StaffOS API endpoints.
  HOOK_EVENTS = {
    "SessionStart"     => "session_start",
    "UserPromptSubmit" => "prompt",
    "PreToolUse"       => "pre_tool",
    "PostToolUse"      => "post_tool",
    "Stop"             => "stop"
  }.freeze

  # Hooks live in Claude Code's per-user settings file, not the shared
  # .claude/settings.json: they call `staffos capture`, so committing them
  # would break Claude Code for anyone who clones the repo without the CLI.
  HOOKS_FILE = ".claude/settings.local.json"
  SHARED_HOOKS_FILE = ".claude/settings.json"

  def generate_hook
    # Command hooks (not HTTP): Claude Code pipes the event JSON to
    # `staffos capture`, which enriches it with the local git branch — the
    # server can't compute the branch, so this is where it must happen.
    hooks = HOOK_EVENTS.map do |claude_event, api_event|
      entry = { "hooks" => [{ "type" => "command", "command" => "staffos capture #{api_event}" }] }
      entry["matcher"] = "Bash|Edit|Write|Read" if %w[PreToolUse PostToolUse].include?(claude_event)
      [claude_event, [entry]]
    end.to_h

    puts "\nClaude Code Hook Configuration (command hooks)"
    puts "─" * 40
    puts "Claude Code pipes each event to `staffos capture`, which adds the git branch."
    puts JSON.pretty_generate({ "hooks" => hooks })

    moved = strip_staffos_hooks(SHARED_HOOKS_FILE)
    strip_staffos_hooks(HOOKS_FILE)

    # Merge per event so the user's own hooks in the same file survive.
    settings = read_settings(HOOKS_FILE)
    settings["hooks"] = {} unless settings["hooks"].is_a?(Hash)
    hooks.each { |event, entries| settings["hooks"][event] = Array(settings["hooks"][event]) + entries }
    FileUtils.mkdir_p(File.dirname(HOOKS_FILE))
    File.write(HOOKS_FILE, JSON.pretty_generate(settings) + "\n")
    puts "\nHook config written to #{HOOKS_FILE}"
    puts "Moved StaffOS hooks out of #{SHARED_HOOKS_FILE}." if moved

    ignore_in_git(HOOKS_FILE)
  end

  # Called by Claude Code's command hooks. Reads the event JSON on stdin, adds
  # the current git branch, and POSTs to StaffOS. Never raises — a capture
  # failure must not break the user's Claude Code session.
  def capture(event)
    creds = capture_credentials
    return unless creds && creds["token"] && event

    data = JSON.parse($stdin.read) rescue {}
    # Without a session id the server would invent an "unknown-..." session
    # and file the event there, so drop unreadable input instead.
    unless data.is_a?(Hash) && data["session_id"]
      warn "staffos capture: dropped #{event} event with no session_id" if ENV["STAFFOS_DEBUG"]
      return
    end

    branch = `git rev-parse --abbrev-ref HEAD 2>/dev/null`.strip
    branch = "unknown" if branch.empty?

    body = { "session_id" => data["session_id"], "branch_name" => branch }
    case event
    when "prompt"
      body["prompt"] = data["prompt"]
    when "pre_tool", "post_tool"
      input, output = apply_privacy(data["tool_name"], data["tool_input"], data["tool_response"] || data["tool_output"])
      body["tool_name"]  = data["tool_name"]
      body["tool_input"] = input
      body["tool_output"] = output
    when "stop"
      snapshot = branch_snapshot(branch)
      body["branch_snapshot"] = snapshot if snapshot
    end

    uri = URI("#{creds['endpoint']}/api/v1/hooks/#{event}")
    http = Net::HTTP.new(uri.host, uri.port)
    http.use_ssl = uri.scheme == "https"
    http.open_timeout = 5
    http.read_timeout = 10
    req = Net::HTTP::Post.new(uri)
    req["Authorization"] = "Bearer #{creds['token']}"
    req["Content-Type"] = "application/json"
    req.body = body.to_json
    http.request(req)
  rescue => e
    warn "staffos capture error: #{e.message}" if ENV["STAFFOS_DEBUG"]
  end

  def help
    puts <<~HELP
      StaffOS CLI v#{VERSION}
      Trust, review, and remember AI-assisted engineering work.

      Usage: staffos <command>

      Commands:
        init       Connect this repo to a StaffOS project
        login      Save a default endpoint and token (optional)
        status     Show connection and project status
        passport   Show latest passport for current branch
        disconnect Remove stored credentials and Claude Code hooks
        hook       Generate and install Claude Code hooks
        version    Show CLI version
        help       Show this help

      Getting started:
        1. Copy the project's API token from the StaffOS Connect page
        2. staffos init       (asks for the endpoint and token, installs hooks)
        3. Use Claude Code normally - events are captured via hooks
        4. Visit StaffOS dashboard to see workstreams and passports

      How it works:
        init installs Claude Code command hooks that run `staffos capture`.
        They go in .claude/settings.local.json, which stays out of git.
        Each event (session start, prompt, tool use, stop) is tagged with
        the current git branch and sent to StaffOS.
        Passports belong to git branches, not sessions. Each branch has
        one living passport, rebuilt every time Claude finishes a reply.

    HELP
  end

  # ── Helpers ──

  def save_credentials(endpoint:, token:)
    dir = File.dirname(CREDENTIALS_FILE)
    FileUtils.mkdir_p(dir)
    File.write(CREDENTIALS_FILE, { "endpoint" => endpoint, "token" => token }.to_yaml)
    File.chmod(0600, CREDENTIALS_FILE)
  end

  # Keep per-user files (project token, hooks) out of version control.
  def ignore_in_git(entry)
    existing = File.exist?(".gitignore") ? File.read(".gitignore") : ""
    return if existing.split("\n").map(&:strip).include?(entry)

    File.open(".gitignore", "a") do |f|
      f.puts "" unless existing.empty? || existing.end_with?("\n")
      f.puts "# StaffOS local config" unless existing.include?("# StaffOS local config")
      f.puts entry
    end
    puts "Added #{entry} to .gitignore"
  end

  # Stops rather than treating a broken file as empty, which would make the
  # next write silently replace the user's settings.
  def read_settings(file)
    return {} unless File.exist?(file)
    settings = JSON.parse(File.read(file))
    raise JSON::ParserError, "top level is not an object" unless settings.is_a?(Hash)
    settings
  rescue JSON::ParserError => e
    puts "Error: #{file} isn't valid JSON (#{e.message.lines.first.strip})."
    puts "Fix or remove it, then run this command again. Nothing was changed."
    exit 1
  end

  # Matches the current command hooks and the HTTP hooks older setups
  # (the web Connect script) installed, so both get cleaned up.
  def staffos_hook_entry?(entry)
    Array(entry.is_a?(Hash) && entry["hooks"]).any? do |h|
      h["command"].to_s.start_with?("staffos capture") || h["url"].to_s.include?("/api/v1/hooks/")
    end
  end

  def staffos_hook_events(file)
    hooks = read_settings(file)["hooks"]
    return [] unless hooks.is_a?(Hash)
    hooks.select { |_, entries| Array(entries).any? { |e| staffos_hook_entry?(e) } }.keys
  end

  # Removes only StaffOS's hook entries, keeping the user's other hooks and
  # settings. Deletes the file if nothing else is left. True if it changed.
  def strip_staffos_hooks(file)
    settings = read_settings(file)
    hooks = settings["hooks"]
    return false unless hooks.is_a?(Hash)

    kept = hooks.transform_values { |entries| Array(entries).reject { |e| staffos_hook_entry?(e) } }
    return false if kept == hooks

    kept.reject! { |_, entries| entries.empty? }
    kept.empty? ? settings.delete("hooks") : settings["hooks"] = kept
    if settings.empty?
      File.delete(file)
    else
      File.write(file, JSON.pretty_generate(settings) + "\n")
    end
    true
  end

  def load_credentials
    return nil unless File.exist?(CREDENTIALS_FILE)
    YAML.load_file(CREDENTIALS_FILE)
  end

  # Token/endpoint used by `capture`. The repo's .staffos.yml wins over the
  # global login so each repo routes to its own StaffOS project — the global
  # token belongs to one project and would misfile every other repo's events.
  def capture_credentials
    config = load_config
    creds = load_credentials || {}
    endpoint = (config && config["api_endpoint"]) || creds["endpoint"]
    token = (config && config["api_token"]) || creds["token"]
    return nil unless endpoint && token
    { "endpoint" => endpoint, "token" => token }
  end

  def load_config
    return nil unless File.exist?(CONFIG_FILE)
    YAML.load_file(CONFIG_FILE)
  end

  def current_branch
    `git rev-parse --abbrev-ref HEAD 2>/dev/null`.strip.then { |b| b.empty? ? "unknown" : b }
  end

  # What is actually on this branch vs where it forked from the default branch —
  # paths and line counts only, never source (privacy model). Lets the server
  # flag branch changes no captured session ever touched. Nil on the default
  # branch itself, outside a repo, or when there is nothing to report.
  def branch_snapshot(branch)
    return nil if branch == "unknown"
    default = default_branch
    return nil if default.nil? || branch == default || branch == default.sub(%r{\Aorigin/}, "")

    base = `git merge-base HEAD #{default} 2>/dev/null`.strip
    return nil if base.empty?

    files = `git diff --numstat #{base} 2>/dev/null`.lines.filter_map do |line|
      adds, dels, path = line.strip.split("\t", 3)
      next if path.nil? || path.empty?
      # Binary files report "-" for counts; to_i maps them to 0.
      { "path" => normalize_numstat_path(path), "additions" => adds.to_i, "deletions" => dels.to_i }
    end

    `git ls-files --others --exclude-standard 2>/dev/null`.lines.each do |line|
      path = line.strip
      files << { "path" => path, "additions" => 0, "deletions" => 0, "untracked" => true } unless path.empty?
    end

    return nil if files.empty?
    { "base_branch" => default, "merge_base" => base, "files" => files }
  end

  # Enforce the project's privacy config (SPEC §17): by default source never
  # leaves the machine — content-bearing fields are replaced client-side with
  # the line-count metadata the server needs. Setting upload_source: true in
  # .staffos.yml opts the project into full capture (richer AI review).
  # Secrets are redacted from commands either way unless redact_secrets: false.
  def apply_privacy(tool, input, output)
    input = (input || {}).dup
    privacy = (load_config || {})["privacy"] || {}
    redact = privacy.fetch("redact_secrets", true)
    if redact
      input["command"] = redact_secrets(input["command"]) if input["command"].is_a?(String)
      # Command *output* is where secrets usually live (cat .env, printenv).
      output = redact_secrets(output) if output.is_a?(String)
    end

    return [input, output] if privacy["upload_source"] == true

    case tool
    when "Edit"
      input["additions"] = input["new_string"].to_s.lines.count
      input["deletions"] = input["old_string"].to_s.lines.count
      input.delete("old_string")
      input.delete("new_string")
    when "Write"
      input["additions"] = input["content"].to_s.lines.count
      input.delete("content")
    when "Read"
      input["lines"] = output.to_s.lines.count if output
    when "Bash"
      # Only post_tool has output; pre_tool must not fib an exit code.
      input["exit_code"] = output.to_s.match?(/exit code/i) ? 1 : 0 if output
    end

    [input, nil]
  end

  SECRET_PATTERNS = [
    /((?:password|passwd|secret|token|api[_-]?key|authorization)\s*[=:]\s*)(?:bearer\s+)?\S+/i,
    /(bearer\s+)[a-z0-9\-._~+\/]{8,}=*/i,
    /(:\/\/[^\s:\/@]+:)[^@\s]+@/i,
    /\b[0-9a-f]{32,}\b/i
  ].freeze

  def redact_secrets(text)
    SECRET_PATTERNS.reduce(text) do |t, pattern|
      t.gsub(pattern) { $1 ? "#{$1}[REDACTED]" : "[REDACTED]" }
    end
  end

  # Renames come back as "app/{models => services}/user.rb" (shared-prefix
  # form) or "old.rb => new.rb"; coverage should track the file's new path.
  def normalize_numstat_path(path)
    return path unless path.include?(" => ")
    if path.include?("{")
      path.gsub(/\{[^{}]*? => ([^{}]*?)\}/) { $1 }.squeeze("/").sub(%r{\A/}, "")
    else
      path.split(" => ").last
    end
  end

  def default_branch
    origin_head = `git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null`.strip
    candidates = []
    candidates << origin_head.sub("refs/remotes/", "") unless origin_head.empty?
    candidates += %w[main master origin/main origin/master]
    candidates.find { |c| system("git rev-parse --verify --quiet #{c} >/dev/null 2>&1") }
  end

  def detect_project_name
    File.basename(Dir.pwd).gsub(/[-_]/, " ").gsub(/\b\w/, &:upcase)
  end

  def detect_repo_name
    remote = `git remote get-url origin 2>/dev/null`.strip
    if remote.match?(%r{[:/]([^/]+/[^/]+?)(?:\.git)?$})
      remote.match(%r{[:/]([^/]+/[^/]+?)(?:\.git)?$})[1]
    else
      "local/#{File.basename(Dir.pwd)}"
    end
  end
end

StaffOSCLI.new(ARGV).run
