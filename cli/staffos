#!/usr/bin/env ruby
# frozen_string_literal: true

require "net/http"
require "json"
require "uri"
require "yaml"
require "fileutils"

class StaffOSCLI
  CONFIG_FILE = ".staffos.yml"
  CREDENTIALS_FILE = File.expand_path("~/.staffos/credentials.yml")
  VERSION = "0.1.2"

  def initialize(args)
    @args = args
    @command = args.first
  end

  def run
    case @command
    when "login"      then login
    when "init"       then init_project
    when "status"     then status
    when "passport"   then passport
    when "disconnect" then disconnect
    when "hook"       then generate_hook
    when "capture"    then capture(@args[1])
    when "version"    then puts "staffos #{VERSION}"
    when "help", nil  then help
    else
      puts "Unknown command: #{@command}"
      help
      exit 1
    end
  end

  private

  # ── Commands ──

  def login
    print "StaffOS API endpoint [http://localhost:9090]: "
    endpoint = $stdin.gets.strip
    endpoint = "http://localhost:9090" if endpoint.empty?

    print "API token: "
    token = $stdin.gets.strip

    if token.empty?
      puts "Error: API token is required."
      exit 1
    end

    endpoint = endpoint.sub(%r{/+\z}, "")

    # Verify connection
    begin
      uri = URI("#{endpoint}/up")
      res = Net::HTTP.get_response(uri)
      if res.code == "200"
        save_credentials(endpoint: endpoint, token: token)
        puts "Logged in to #{endpoint}"
      else
        puts "Connection failed (HTTP #{res.code})."
        exit 1
      end
    rescue => e
      puts "Connection failed: #{e.message}"
      exit 1
    end
  end

  def init_project
    if File.exist?(CONFIG_FILE)
      puts "Project already initialized (#{CONFIG_FILE} exists)."
      config = YAML.load_file(CONFIG_FILE)
      puts "  Project: #{config['project_name']}"
      puts "  Endpoint: #{config['api_endpoint']}"
      return
    end

    creds = load_credentials
    unless creds
      puts "Not logged in. Run 'staffos login' first."
      exit 1
    end

    project_name = detect_project_name
    repo_name = detect_repo_name

    print "Project name [#{project_name}]: "
    input = $stdin.gets.strip
    project_name = input unless input.empty?

    config = {
      "project_name" => project_name,
      "repo_name" => repo_name,
      "api_endpoint" => creds["endpoint"],
      "privacy" => {
        "upload_source" => false,
        "upload_diffs" => "metadata_only",
        "redact_secrets" => true
      }
    }

    File.write(CONFIG_FILE, config.to_yaml)
    puts "Created #{CONFIG_FILE}"

    ignore_local_config

    generate_hook
    puts "\nProject initialized. Start Claude Code and events will be captured."
  end

  def status
    config = load_config
    creds = load_credentials

    puts "StaffOS Status"
    puts "─" * 40
    puts "Version:     #{VERSION}"
    puts "Project:     #{config ? config['project_name'] : 'Not initialized'}"
    puts "Repo:        #{config ? config['repo_name'] : 'N/A'}"
    puts "Branch:      #{current_branch}"
    puts "Endpoint:    #{creds ? creds['endpoint'] : 'Not logged in'}"
    puts "Config:      #{File.exist?(CONFIG_FILE) ? CONFIG_FILE : 'Not found'}"
    puts "Credentials: #{File.exist?(CREDENTIALS_FILE) ? 'Saved' : 'Not found'}"

    hooks_file = ".claude/settings.json"
    if File.exist?(hooks_file)
      settings = JSON.parse(File.read(hooks_file)) rescue {}
      hook_count = (settings["hooks"] || {}).keys.length
      puts "Hooks:       #{hook_count > 0 ? "#{hook_count} events configured" : 'Not configured'}"
    else
      puts "Hooks:       Not configured"
    end

    if creds
      print "\nConnection:  Testing... "
      uri = URI("#{creds['endpoint']}/up")
      begin
        res = Net::HTTP.get_response(uri)
        puts res.code == "200" ? "OK" : "Failed (#{res.code})"
      rescue => e
        puts "Failed (#{e.message})"
      end
    end
  end

  def passport
    creds = load_credentials
    config = load_config
    unless creds && config
      puts "Not initialized. Run 'staffos login' and 'staffos init'."
      exit 1
    end

    branch = current_branch
    puts "Fetching passport for branch: #{branch}"
    puts "─" * 40
    puts "Project:  #{config['project_name']}"
    puts "Branch:   #{branch}"
    puts "Endpoint: #{creds['endpoint']}"
    puts "\nView in browser: #{creds['endpoint']}/workstreams"
  end

  def disconnect
    removed = []

    if File.exist?(CREDENTIALS_FILE)
      File.delete(CREDENTIALS_FILE)
      removed << "credentials (#{CREDENTIALS_FILE})"
    end

    # Strip StaffOS hooks from .claude/settings.json, leaving other settings intact.
    settings_file = ".claude/settings.json"
    if File.exist?(settings_file)
      settings = JSON.parse(File.read(settings_file)) rescue {}
      if settings.delete("hooks")
        if settings.empty?
          File.delete(settings_file)
        else
          File.write(settings_file, JSON.pretty_generate(settings))
        end
        removed << "Claude Code hooks (#{settings_file})"
      end
    end

    if removed.empty?
      puts "Nothing to disconnect — no StaffOS credentials or hooks found."
    else
      puts "Disconnected from StaffOS. Removed:"
      removed.each { |item| puts "  - #{item}" }
      puts "\nYour project config (#{CONFIG_FILE}) was left in place. Delete it manually to fully reset."
    end
  end

  # Claude Code hook events → StaffOS API endpoints.
  HOOK_EVENTS = {
    "SessionStart"     => "session_start",
    "UserPromptSubmit" => "prompt",
    "PreToolUse"       => "pre_tool",
    "PostToolUse"      => "post_tool",
    "Stop"             => "stop"
  }.freeze

  def generate_hook
    # Command hooks (not HTTP): Claude Code pipes the event JSON to
    # `staffos capture`, which enriches it with the local git branch — the
    # server can't compute the branch, so this is where it must happen.
    hooks = HOOK_EVENTS.map do |claude_event, api_event|
      entry = { "hooks" => [{ "type" => "command", "command" => "staffos capture #{api_event}" }] }
      entry["matcher"] = "Bash|Edit|Write|Read" if %w[PreToolUse PostToolUse].include?(claude_event)
      [claude_event, [entry]]
    end.to_h

    puts "\nClaude Code Hook Configuration (command hooks)"
    puts "─" * 40
    puts "Claude Code pipes each event to `staffos capture`, which adds the git branch."
    puts JSON.pretty_generate({ "hooks" => hooks })

    claude_dir = ".claude"
    settings_file = "#{claude_dir}/settings.json"
    FileUtils.mkdir_p(claude_dir)
    existing = File.exist?(settings_file) ? (JSON.parse(File.read(settings_file)) rescue {}) : {}
    existing["hooks"] = hooks
    File.write(settings_file, JSON.pretty_generate(existing))
    puts "\nHook config written to #{settings_file}"
  end

  # Called by Claude Code's command hooks. Reads the event JSON on stdin, adds
  # the current git branch, and POSTs to StaffOS. Never raises — a capture
  # failure must not break the user's Claude Code session.
  def capture(event)
    creds = load_credentials
    return unless creds && creds["token"] && event

    data = JSON.parse($stdin.read) rescue {}
    branch = `git rev-parse --abbrev-ref HEAD 2>/dev/null`.strip
    branch = "unknown" if branch.empty?

    body = { "session_id" => data["session_id"], "branch_name" => branch }
    case event
    when "prompt"
      body["prompt"] = data["prompt"]
    when "pre_tool", "post_tool"
      body["tool_name"]  = data["tool_name"]
      body["tool_input"] = data["tool_input"]
      body["tool_output"] = data["tool_response"] || data["tool_output"]
    end

    uri = URI("#{creds['endpoint']}/api/v1/hooks/#{event}")
    http = Net::HTTP.new(uri.host, uri.port)
    http.use_ssl = uri.scheme == "https"
    http.open_timeout = 5
    http.read_timeout = 10
    req = Net::HTTP::Post.new(uri)
    req["Authorization"] = "Bearer #{creds['token']}"
    req["Content-Type"] = "application/json"
    req.body = body.to_json
    http.request(req)
  rescue => e
    warn "staffos capture error: #{e.message}" if ENV["STAFFOS_DEBUG"]
  end

  def help
    puts <<~HELP
      StaffOS CLI v#{VERSION}
      Trust, review, and remember AI-assisted engineering work.

      Usage: staffos <command>

      Commands:
        login      Connect to a StaffOS instance
        init       Initialize project in current directory
        status     Show connection and project status
        passport   Show latest passport for current branch
        disconnect Remove stored credentials and Claude Code hooks
        hook       Generate and install Claude Code hooks
        version    Show CLI version
        help       Show this help

      Getting started:
        1. staffos login      (enter your API endpoint and token)
        2. staffos init       (creates .staffos.yml and installs hooks)
        3. Use Claude Code normally - events are captured via HTTP hooks
        4. Visit StaffOS dashboard to see workstreams and passports

      How it works:
        StaffOS uses Claude Code's HTTP hooks to capture lifecycle events.
        When Claude Code starts a session, submits a prompt, uses a tool,
        or stops - it POSTs the full event context to StaffOS automatically.
        No curl commands or environment variable interpolation needed.

    HELP
  end

  # ── Helpers ──

  def save_credentials(endpoint:, token:)
    dir = File.dirname(CREDENTIALS_FILE)
    FileUtils.mkdir_p(dir)
    File.write(CREDENTIALS_FILE, { "endpoint" => endpoint, "token" => token }.to_yaml)
    File.chmod(0600, CREDENTIALS_FILE)
  end

  # Keep the local project config out of version control (it's per-user).
  def ignore_local_config
    entry = File.basename(CONFIG_FILE)
    existing = File.exist?(".gitignore") ? File.read(".gitignore") : ""
    return if existing.split("\n").map(&:strip).include?(entry)

    File.open(".gitignore", "a") do |f|
      f.puts "" unless existing.empty? || existing.end_with?("\n")
      f.puts "# StaffOS local config"
      f.puts entry
    end
    puts "Added #{entry} to .gitignore"
  end

  def load_credentials
    return nil unless File.exist?(CREDENTIALS_FILE)
    YAML.load_file(CREDENTIALS_FILE)
  end

  def load_config
    return nil unless File.exist?(CONFIG_FILE)
    YAML.load_file(CONFIG_FILE)
  end

  def current_branch
    `git rev-parse --abbrev-ref HEAD 2>/dev/null`.strip.then { |b| b.empty? ? "unknown" : b }
  end

  def detect_project_name
    File.basename(Dir.pwd).gsub(/[-_]/, " ").gsub(/\b\w/, &:upcase)
  end

  def detect_repo_name
    remote = `git remote get-url origin 2>/dev/null`.strip
    if remote.match?(%r{[:/]([^/]+/[^/]+?)(?:\.git)?$})
      remote.match(%r{[:/]([^/]+/[^/]+?)(?:\.git)?$})[1]
    else
      "local/#{File.basename(Dir.pwd)}"
    end
  end
end

StaffOSCLI.new(ARGV).run
