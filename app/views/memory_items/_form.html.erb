<%= form_with(model: memory_item, url: memory_item.persisted? ? memory_item_path(memory_item) : memory_items_path, class: "space-y-6") do |f| %>
  <% if memory_item.errors.any? %>
    <div class="p-4 rounded-sm bg-danger-soft border border-danger/20 text-danger text-sm">
      <% memory_item.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>
  <div>
    <label class="block text-text-soft text-sm font-bold mb-2">Type</label>
    <%= f.select :memory_type, MemoryItem::TYPES.map { |t| [t.capitalize, t] },
      {}, class: "w-full h-11 px-3 border border-panel-border rounded-sm bg-white text-text-primary outline-none focus:border-primary/40" %>
  </div>
  <div>
    <label class="block text-text-soft text-sm font-bold mb-2">Content</label>
    <%= f.text_area :content, rows: 8, class: "w-full p-4 border border-panel-border rounded-sm bg-white text-text-soft text-sm placeholder:text-text-muted outline-none focus:border-primary/40 resize-y", placeholder: "What should be remembered?" %>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="block text-text-soft text-sm font-bold mb-2">Confidence (0-1)</label>
      <%= f.number_field :confidence, step: 0.1, min: 0, max: 1, class: "w-full h-11 px-3 border border-panel-border rounded-sm bg-white text-text-primary outline-none focus:border-primary/40" %>
    </div>
    <div>
      <label class="block text-text-soft text-sm font-bold mb-2">Expires At</label>
      <%= f.datetime_local_field :expires_at, class: "w-full h-11 px-3 border border-panel-border rounded-sm bg-white text-text-primary outline-none focus:border-primary/40" %>
    </div>
  </div>
  <div class="flex gap-3">
    <%= f.submit class: "h-[42px] px-6 rounded-sm btn-primary font-bold cursor-pointer border-0" %>
    <%= link_to "Cancel", memory_items_path, class: "h-[42px] px-4 border border-panel-border rounded-sm bg-white text-text-primary font-bold inline-flex items-center no-underline hover:bg-bg" %>
  </div>
<% end %>
