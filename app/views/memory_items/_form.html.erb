<%= form_with(model: memory_item, url: memory_item.persisted? ? memory_item_path(memory_item) : memory_items_path, class: "space-y-6") do |f| %>
  <% if memory_item.errors.any? %>
    <div class="p-4 rounded-sm bg-danger-soft border border-danger/20 text-danger text-sm">
      <% memory_item.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>
  <div>
    <label class="label">Type</label>
    <%= f.select :memory_type, MemoryItem::TYPES.map { |t| [t.capitalize, t] },
      {}, class: "input h-11" %>
  </div>
  <div>
    <label class="label">Content</label>
    <%= f.text_area :content, rows: 8, class: "input resize-y", placeholder: "What should be remembered?" %>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="label">Confidence (0-1)</label>
      <%= f.number_field :confidence, step: 0.1, min: 0, max: 1, class: "input h-11" %>
    </div>
    <div>
      <label class="label">Expires At</label>
      <%= f.datetime_local_field :expires_at, class: "input h-11" %>
    </div>
  </div>
  <div class="flex gap-3">
    <%= f.submit class: "h-[42px] px-6 rounded-sm btn-primary font-bold cursor-pointer border-0" %>
    <%= link_to "Cancel", memory_items_path, class: "btn-secondary btn-lg" %>
  </div>
<% end %>
