<!DOCTYPE html>
<html <%= tag.attributes(html_theme_attrs) %>>
  <head>
    <title><%= content_for(:title) || "StaffOS" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="StaffOS">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= render "shared/head_common" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="font-sans text-text-primary antialiased overflow-x-hidden" data-controller="help sidebar">
    <%# Mobile drawer backdrop %>
    <div data-sidebar-target="backdrop" data-action="click->sidebar#close"
         class="hidden fixed inset-0 z-30 bg-black/30 backdrop-blur-sm lg:hidden"></div>

    <div class="grid grid-cols-[260px_1fr] min-h-screen max-lg:grid-cols-1">
      <%= render "shared/sidebar" %>

      <main class="min-w-0">
        <%= render "shared/topbar" %>
        <section class="p-7 max-lg:p-4">
          <% if notice %>
            <div class="mb-4 p-3 rounded-sm bg-success-soft border border-success/20 text-success text-sm font-semibold" data-controller="flash">
              <%= notice %>
              <button class="float-right text-xs opacity-70 hover:opacity-100" data-action="flash#dismiss">dismiss</button>
            </div>
          <% end %>
          <% if alert %>
            <div class="mb-4 p-3 rounded-sm bg-danger-soft border border-danger/20 text-danger text-sm font-semibold" data-controller="flash">
              <%= alert %>
              <button class="float-right text-xs opacity-70 hover:opacity-100" data-action="flash#dismiss">dismiss</button>
            </div>
          <% end %>
          <%= yield %>
        </section>
      </main>
    </div>

    <%= render "shared/help_overlay" %>
  </body>
</html>
