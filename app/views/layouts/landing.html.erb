<!DOCTYPE html>
<html <%= tag.attributes(html_theme_attrs) %>>
  <head>
    <title>StaffOS — Trust every line your AI writes</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="StaffOS turns every AI coding session into a Run Passport: a verified record of what changed, what was tested, and what still needs a human.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= render "shared/head_common" %>
    <%= stylesheet_link_tag :app %>
  </head>

  <body class="font-sans text-text-primary antialiased bg-bg">
    <%= yield %>
  </body>
</html>
