<%= form_with(model: decision_log, class: "space-y-6") do |f| %>
  <% if decision_log.errors.any? %>
    <div class="p-4 rounded-sm bg-danger-soft border border-danger/20 text-danger text-sm">
      <% decision_log.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>
  <% [[:title, "Title", :text_field], [:context, "Context", :text_area], [:decision, "Decision", :text_area], [:rationale, "Rationale", :text_area], [:consequences, "Consequences", :text_area]].each do |field, label, type| %>
    <div>
      <label class="label"><%= label %></label>
      <% if type == :text_field %>
        <%= f.text_field field, class: "input h-11" %>
      <% else %>
        <%= f.text_area field, rows: 4, class: "input resize-y" %>
      <% end %>
    </div>
  <% end %>
  <div>
    <label class="label">Status</label>
    <%= f.select :status, DecisionLog::STATUSES.map { |s| [s.capitalize, s] },
      {}, class: "input h-11" %>
  </div>
  <div class="flex gap-3">
    <%= f.submit class: "h-[42px] px-6 rounded-sm btn-primary font-bold cursor-pointer border-0" %>
    <%= link_to "Cancel", decision_logs_path, class: "btn-secondary btn-lg" %>
  </div>
<% end %>
