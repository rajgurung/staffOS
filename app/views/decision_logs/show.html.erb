<div class="flex justify-between items-start mb-6">
  <div>
    <%= status_pill(@decision_log.status&.capitalize || "Draft", color: @decision_log.status_color.to_sym) %>
    <h1 class="heading-1 mt-2 mb-2"><%= @decision_log.title %></h1>
    <p class="text-text-muted text-sm"><%= @decision_log.project.name %> &middot; Created <%= time_ago_in_words(@decision_log.created_at) %> ago</p>
  </div>
  <div class="flex gap-3">
    <%= link_to "Edit", edit_decision_log_path(@decision_log), class: "btn-secondary btn-lg" %>
    <%= link_to "Delete", decision_log_path(@decision_log), data: { turbo_method: :delete, turbo_confirm: "Delete?" }, class: "h-[42px] px-4 border border-danger/20 rounded-sm bg-danger-soft text-danger font-bold inline-flex items-center no-underline" %>
  </div>
</div>

<div class="grid grid-cols-2 gap-4 max-xl:grid-cols-1">
  <%= card(title: "Context") do %><p class="text-text-soft text-sm leading-[1.7]"><%= simple_format(@decision_log.context) %></p><% end %>
  <%= card(title: "Decision") do %><p class="text-text-primary text-sm leading-[1.7] font-semibold"><%= simple_format(@decision_log.decision) %></p><% end %>
  <%= card(title: "Rationale") do %><p class="text-text-soft text-sm leading-[1.7]"><%= simple_format(@decision_log.rationale) %></p><% end %>
  <%= card(title: "Consequences") do %><p class="text-text-soft text-sm leading-[1.7]"><%= simple_format(@decision_log.consequences) %></p><% end %>
</div>
