<header class="h-14 flex items-center justify-between gap-4 px-6 border-b border-panel-border bg-white max-lg:px-4">
  <div class="flex items-center gap-3">
    <div class="h-8 flex items-center gap-2 px-3 border border-panel-border rounded-md bg-bg text-[13px] font-semibold text-text-primary cursor-pointer hover:border-panel-border-strong transition-colors">
      <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
      AI Peer Review Pipeline
      <svg class="w-3.5 h-3.5 text-text-muted ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
    </div>
  </div>

  <div class="flex-1 max-w-md">
    <%= form_tag search_path, method: :get, class: "w-full" do %>
      <input name="q" value="<%= params[:q] %>"
        class="w-full h-8 px-3 border border-panel-border rounded-md bg-bg text-[13px] text-text-soft placeholder:text-text-muted outline-none focus:border-primary/40 focus:shadow-[0_0_0_3px_rgba(91,95,247,0.08)] transition-all"
        placeholder="Search passports, docs, decisions..." />
    <% end %>
  </div>

  <div class="flex items-center gap-2">
    <button class="w-8 h-8 rounded-md border border-panel-border bg-bg grid place-items-center text-text-muted hover:text-text-primary hover:border-panel-border-strong transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
    </button>
    <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "text-text-muted text-[12px] font-medium hover:text-text-soft no-underline transition-colors" do %>
      Sign out
    <% end %>
  </div>
</header>
