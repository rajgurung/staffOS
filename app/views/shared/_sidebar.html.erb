<aside data-sidebar-target="panel" data-action="click->sidebar#closeOnNavigate"
       class="flex flex-col bg-white border-r border-panel-border py-5 px-3
              transition-transform duration-200
              lg:sticky lg:top-0 lg:h-screen lg:translate-x-0
              max-lg:fixed max-lg:inset-y-0 max-lg:left-0 max-lg:z-40 max-lg:w-[260px] max-lg:shadow-elevated
              -translate-x-full">
  <div class="flex items-center gap-2.5 px-3 mb-8">
    <%= link_to root_path, class: "flex items-center gap-2.5 no-underline" do %>
      <span class="w-7 h-7 rounded-lg bg-gradient-to-br from-primary to-purple grid place-items-center text-white text-xs font-bold shadow-primary">S</span>
      <span class="text-[17px] font-[750] tracking-[-0.04em] text-text-primary">StaffOS</span>
    <% end %>
  </div>

  <nav class="flex-1 space-y-6">
    <div>
      <p class="px-3 mb-1 text-text-muted text-[10px] font-semibold tracking-[0.08em] uppercase">Work</p>
      <%= sidebar_link "Workstreams", workstreams_path, "workstreams", icon: "workstreams" %>
      <%= sidebar_link "Risk Cockpit", risk_cockpit_path, "risk", icon: "risk" %>
    </div>

    <div>
      <p class="px-3 mb-1 text-text-muted text-[10px] font-semibold tracking-[0.08em] uppercase">Project Knowledge</p>
      <%= sidebar_link "Decisions", decision_logs_path, "decisions", icon: "decisions" %>
      <%= sidebar_link "Documentation", documents_path, "docs", icon: "docs" %>
      <%= sidebar_link "Memory", memory_items_path, "memory", icon: "memory" %>
    </div>

    <div>
      <p class="px-3 mb-1 text-text-muted text-[10px] font-semibold tracking-[0.08em] uppercase">System</p>
      <%= sidebar_link "Sessions", runs_path, "runs", icon: "sessions" %>
      <%= sidebar_link "Run Passports", run_passports_path, "passports", icon: "passports" %>
      <%= sidebar_link "Connect", connect_path, "connect", icon: "connect" %>
      <%= sidebar_link "Projects", projects_path, "projects", icon: "projects" %>
      <%= sidebar_link "Settings", settings_path, "settings", icon: "settings" %>
    </div>

    <%# Active Workstreams quick list %>
    <% active_workstreams = current_project&.workstreams&.active&.recent&.limit(5) || [] %>
    <% if active_workstreams.any? %>
      <div>
        <p class="px-3 mb-1 text-text-muted text-[10px] font-semibold tracking-[0.08em] uppercase">Active Branches</p>
        <% active_workstreams.each do |ws| %>
          <%= link_to workstream_path(ws), class: "flex items-center gap-2 h-7 px-3 rounded-md text-[12px] no-underline transition-colors #{current_page?(workstream_path(ws)) ? 'sidebar-active' : 'text-text-soft hover:text-text-primary hover:bg-bg'}" do %>
            <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
            <span class="truncate"><%= ws.branch_name %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </nav>

  <div class="px-3 pt-4 border-t border-panel-border">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-full bg-primary-soft text-primary grid place-items-center text-xs font-bold">
        <%= current_user.name&.first&.upcase || current_user.email.first.upcase %>
      </div>
      <div class="min-w-0 flex-1">
        <p class="text-[13px] font-semibold text-text-primary truncate m-0"><%= current_user.name || current_user.email.split("@").first %></p>
        <p class="text-[11px] text-text-muted truncate m-0"><%= current_user.email %></p>
      </div>
    </div>
  </div>
</aside>
