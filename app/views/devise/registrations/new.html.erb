<h2 class="text-lg font-[700] tracking-[-0.03em] mb-5">Create your account</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div>
    <label class="block text-text-soft text-[12px] font-medium mb-1">Name</label>
    <%= f.text_field :name, autofocus: true,
      class: "w-full h-9 px-3 border border-panel-border rounded-md bg-bg text-[13px] text-text-primary placeholder:text-text-muted outline-none",
      placeholder: "Your name" %>
  </div>

  <div>
    <label class="block text-text-soft text-[12px] font-medium mb-1">Email</label>
    <%= f.email_field :email, autocomplete: "email",
      class: "w-full h-9 px-3 border border-panel-border rounded-md bg-bg text-[13px] text-text-primary placeholder:text-text-muted outline-none",
      placeholder: "you@example.com" %>
  </div>

  <div>
    <label class="block text-text-soft text-[12px] font-medium mb-1">Password</label>
    <%= f.password_field :password, autocomplete: "new-password",
      class: "w-full h-9 px-3 border border-panel-border rounded-md bg-bg text-[13px] text-text-primary placeholder:text-text-muted outline-none",
      placeholder: "Min 6 characters" %>
  </div>

  <div>
    <label class="block text-text-soft text-[12px] font-medium mb-1">Confirm password</label>
    <%= f.password_field :password_confirmation, autocomplete: "new-password",
      class: "w-full h-9 px-3 border border-panel-border rounded-md bg-bg text-[13px] text-text-primary placeholder:text-text-muted outline-none",
      placeholder: "Confirm password" %>
  </div>

  <div>
    <%= f.submit "Create account", class: "w-full h-9 rounded-md btn-primary text-[13px] font-semibold cursor-pointer border-0" %>
  </div>
<% end %>

<div class="mt-5 text-center">
  <p class="text-text-muted text-[12px] m-0">
    Already have an account? <%= link_to "Sign in", new_session_path(resource_name), class: "text-primary font-semibold hover:underline" %>
  </p>
</div>
