<h2 class="text-lg font-[700] tracking-[-0.03em] mb-5">Sign in to StaffOS</h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
  <div>
    <label class="block text-text-soft text-[12px] font-medium mb-1">Email</label>
    <%= f.email_field :email, autofocus: true, autocomplete: "email",
      class: "w-full h-9 px-3 border border-panel-border rounded-md bg-bg text-[13px] text-text-primary placeholder:text-text-muted outline-none",
      placeholder: "you@example.com" %>
  </div>

  <div>
    <label class="block text-text-soft text-[12px] font-medium mb-1">Password</label>
    <%= f.password_field :password, autocomplete: "current-password",
      class: "w-full h-9 px-3 border border-panel-border rounded-md bg-bg text-[13px] text-text-primary placeholder:text-text-muted outline-none",
      placeholder: "Your password" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="flex items-center gap-2">
      <%= f.check_box :remember_me, class: "w-3.5 h-3.5 rounded border-panel-border" %>
      <label class="text-text-soft text-[12px]">Remember me</label>
    </div>
  <% end %>

  <div>
    <%= f.submit "Sign in", class: "w-full h-9 rounded-md btn-primary text-[13px] font-semibold cursor-pointer border-0" %>
  </div>
<% end %>

<div class="mt-5 text-center space-y-1.5">
  <%- if devise_mapping.registerable? %>
    <p class="text-text-muted text-[12px] m-0">
      No account? <%= link_to "Create one", new_registration_path(resource_name), class: "text-primary font-semibold hover:underline" %>
    </p>
  <% end %>
  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <p class="m-0"><%= link_to "Forgot password?", new_password_path(resource_name), class: "text-text-muted text-[12px] hover:text-text-soft" %></p>
  <% end %>
</div>
