<div class="flex justify-between items-start mb-6">
  <div>
    <h1 class="text-[30px] font-[800] leading-tight tracking-[-0.05em] mb-2"><%= @project.name %></h1>
    <p class="text-text-muted text-sm"><%= @project.repo_name %></p>
  </div>
  <div class="flex gap-3">
    <%= link_to "Hook Config", hook_config_project_path(@project), class: "h-[42px] px-4 border border-panel-border rounded-sm bg-white text-text-primary font-bold inline-flex items-center no-underline hover:bg-bg" %>
    <%= link_to "Edit", edit_project_path(@project), class: "h-[42px] px-4 border border-panel-border rounded-sm bg-white text-text-primary font-bold inline-flex items-center no-underline hover:bg-bg" %>
  </div>
</div>

<div class="grid grid-cols-3 gap-4 mb-6 max-xl:grid-cols-1">
  <%= card(title: "Tech Stack") do %>
    <div class="flex flex-wrap gap-2">
      <% @project.tech_stack_list.each do |tech| %>
        <span class="py-[7px] px-2.5 rounded-full bg-primary-soft text-primary-dark text-xs font-[850]"><%= tech %></span>
      <% end %>
    </div>
  <% end %>

  <%= card(title: "Stats") do %>
    <div class="space-y-2 text-sm">
      <div class="flex justify-between"><span class="text-text-muted">Total Runs</span><span class="font-bold"><%= @project.agent_sessions.count %></span></div>
      <div class="flex justify-between"><span class="text-text-muted">Passports</span><span class="font-bold"><%= @project.run_passports.count %></span></div>
      <div class="flex justify-between"><span class="text-text-muted">Documents</span><span class="font-bold"><%= @project.documents.count %></span></div>
      <div class="flex justify-between"><span class="text-text-muted">Decisions</span><span class="font-bold"><%= @project.decision_logs.count %></span></div>
    </div>
  <% end %>

  <%= card(title: "API Tokens") do %>
    <div class="space-y-2 mb-3">
      <% @tokens.each do |token| %>
        <div class="flex justify-between items-center text-sm">
          <div>
            <span class="text-text-soft font-semibold"><%= token.name %></span>
            <code class="text-text-muted text-xs ml-2"><%= token.masked_token %></code>
          </div>
          <%= link_to "Revoke", project_api_token_path(@project, token), data: { turbo_method: :delete, turbo_confirm: "Revoke?" }, class: "text-danger text-xs font-bold no-underline" %>
        </div>
      <% end %>
    </div>
    <%= button_to "Generate Token", project_api_tokens_path(@project), params: { name: "CLI Token" }, class: "h-9 px-3 border border-panel-border rounded-sm bg-white text-text-soft text-sm font-bold cursor-pointer hover:bg-bg" %>
  <% end %>
</div>

<%= card(title: "Workstream Tree", classes: "mb-6") do %>
  <div class="flex items-center gap-2.5 mb-2">
    <span class="text-[14px] font-[800] tracking-[-0.02em]"><%= @project.name %></span>
    <code class="text-[11px] text-text-muted"><%= @project.repo_name %></code>
  </div>

  <% if @workstreams.empty? && @unassigned_sessions.empty? %>
    <p class="text-text-muted text-sm m-0">No workstreams or sessions yet. They appear when Claude Code sessions are captured.</p>
  <% else %>
    <div class="ml-1.5 border-l border-panel-border pl-4 space-y-1">
      <% @workstreams.each do |ws| %>
        <details class="group" <%= "open" if ws.status == "active" %>>
          <summary class="flex items-center gap-2.5 py-1.5 px-2 rounded-sm cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-bg">
            <svg class="w-3 h-3 text-text-muted shrink-0 transition-transform group-open:rotate-90" viewBox="0 0 12 12" fill="currentColor"><path d="M4 2l5 4-5 4V2z"/></svg>
            <span class="w-2 h-2 rounded-full bg-<%= ws.status_color %> <%= ws.status == 'active' ? 'animate-pulse' : '' %> shrink-0"></span>
            <span class="text-[13px] font-[700] text-text-primary truncate"><%= ws.display_name %></span>
            <code class="text-[11px] text-primary shrink-0"><%= ws.branch_name %></code>
            <%= status_pill(ws.status.titleize, color: ws.status_color.to_sym) %>
            <span class="ml-auto flex items-center gap-2 shrink-0">
              <span class="text-[11px] text-text-muted"><%= ws.agent_sessions.size %> session<%= ws.agent_sessions.size == 1 ? '' : 's' %></span>
              <% if ws.current_passport %>
                <span class="text-[13px] font-[800]"><%= ws.current_passport.readiness_score %>%</span>
              <% end %>
              <%= link_to "View", workstream_path(ws), class: "text-[11px] font-bold text-primary no-underline hover:underline" %>
            </span>
          </summary>
          <div class="ml-[5px] border-l border-panel-border pl-4 mt-0.5">
            <% ws.agent_sessions.sort_by { |s| s.started_at || Time.at(0) }.reverse.each do |session| %>
              <%= render "tree_session", session: session %>
            <% end %>
            <% if ws.agent_sessions.empty? %>
              <p class="text-[11px] text-text-muted py-1.5 px-2 m-0">No sessions yet</p>
            <% end %>
          </div>
        </details>
      <% end %>

      <% if @unassigned_sessions.any? %>
        <details class="group">
          <summary class="flex items-center gap-2.5 py-1.5 px-2 rounded-sm cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-bg">
            <svg class="w-3 h-3 text-text-muted shrink-0 transition-transform group-open:rotate-90" viewBox="0 0 12 12" fill="currentColor"><path d="M4 2l5 4-5 4V2z"/></svg>
            <span class="w-2 h-2 rounded-full bg-panel-border shrink-0"></span>
            <span class="text-[13px] font-[700] text-text-muted">Unassigned sessions</span>
            <span class="ml-auto text-[11px] text-text-muted shrink-0"><%= @unassigned_sessions.size %></span>
          </summary>
          <div class="ml-[5px] border-l border-panel-border pl-4 mt-0.5">
            <% @unassigned_sessions.each do |session| %>
              <%= render "tree_session", session: session %>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>
  <% end %>
<% end %>

<%= card(title: "Risk Rules") do %>
  <% if @project.risk_rules.present? %>
    <div class="space-y-2">
      <% @project.risk_rules.each do |pattern, level| %>
        <div class="flex justify-between items-center text-sm p-2 rounded-sm bg-bg/50">
          <code class="text-primary"><%= pattern %></code>
          <span class="<%= risk_color(level) %> font-bold text-xs uppercase"><%= level %></span>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-text-muted text-sm">No custom risk rules. Default rules applied.</p>
  <% end %>
<% end %>
