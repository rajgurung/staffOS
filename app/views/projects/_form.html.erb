<%= form_with(model: project, class: "space-y-6") do |f| %>
  <% if project.errors.any? %>
    <div class="p-4 rounded-md bg-danger-soft border border-danger/10 text-danger text-sm">
      <% project.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>
  <div>
    <label class="label">Project Name</label>
    <%= f.text_field :name, class: "input h-9", placeholder: "My Project" %>
  </div>
  <div>
    <label class="label">Repository</label>
    <%= f.text_field :repo_name, class: "input h-9", placeholder: "org/repo" %>
  </div>
  <div>
    <label class="label">Tech Stack (comma-separated)</label>
    <%= f.text_field :tech_stack, class: "input h-9", placeholder: "Ruby on Rails, PostgreSQL, Redis" %>
  </div>

  <%# Risk Rules Editor %>
  <div data-controller="risk-rules">
    <label class="label">Risk Rules</label>
    <div class="border border-panel-border rounded-md bg-panel-solid p-3">
      <div data-risk-rules-target="list">
        <% (project.risk_rules || {}).each do |pattern, level| %>
          <div class="flex items-center gap-2 py-2 border-b border-panel-border last:border-0">
            <input type="hidden" name="project[risk_rules][<%= pattern %>]" value="<%= level %>" />
            <code class="text-primary text-[12px] flex-1"><%= pattern %></code>
            <span class="text-[11px] font-semibold uppercase <%= level == 'high' ? 'text-danger' : level == 'medium' ? 'text-warning' : 'text-success' %>"><%= level %></span>
            <button type="button" data-action="risk-rules#remove" class="text-danger text-[11px] font-semibold cursor-pointer bg-transparent border-0">Remove</button>
          </div>
        <% end %>
      </div>
      <div class="flex gap-2 mt-3 pt-3 border-t border-panel-border">
        <input data-field="pattern" placeholder="e.g. auth, payment, migration" class="flex-1 h-8 px-2 border border-panel-border rounded-md bg-bg text-[12px] text-text-primary placeholder:text-text-muted outline-none" />
        <select data-field="level" class="h-8 px-2 border border-panel-border rounded-md bg-bg text-[12px] text-text-primary outline-none">
          <option value="high">High</option>
          <option value="medium">Medium</option>
          <option value="low">Low</option>
        </select>
        <button type="button" data-action="risk-rules#add" class="h-8 px-3 rounded-md btn-primary text-[11px] font-semibold border-0 cursor-pointer">Add</button>
      </div>
    </div>
  </div>

  <div class="flex gap-3">
    <%= f.submit class: "h-9 px-5 rounded-md btn-primary text-[12px] font-semibold cursor-pointer border-0" %>
    <%= link_to "Cancel", projects_path, class: "btn-secondary h-9" %>
  </div>
<% end %>
