<%# Header %>
<div class="flex justify-between items-start mb-5">
  <div>
    <div class="flex items-center gap-2.5 mb-1">
      <span class="w-2.5 h-2.5 rounded-full bg-<%= @workstream.status_color %> <%= @workstream.status == 'active' ? 'animate-pulse' : '' %>"></span>
      <h1 class="heading-1 m-0"><%= @workstream.display_name %></h1>
      <%= status_pill(@workstream.status.titleize, color: @workstream.status_color.to_sym) %>
    </div>
    <p class="text-text-muted text-[13px] mt-1">
      <code class="text-primary text-[12px]"><%= @workstream.branch_name %></code>
      &middot; <%= @workstream.project.name %>
      &middot; <%= @workstream.total_sessions %> sessions
      &middot; <%= @workstream.total_events %> events
    </p>
    <% if @workstream.description.present? %>
      <p class="text-text-soft text-[13px] mt-2"><%= @workstream.description %></p>
    <% end %>
  </div>
  <div class="flex gap-2">
    <%= link_to "Edit", edit_workstream_path(@workstream), class: "h-8 px-3 rounded-md btn-secondary text-[12px] font-semibold inline-flex items-center no-underline" %>
    <% if @workstream.status == "in_review" %>
      <%= button_to "Mark as Merged", promote_workstream_path(@workstream), class: "h-8 px-3 rounded-md btn-primary text-[12px] font-semibold border-0 cursor-pointer", data: { turbo_confirm: "Merge this workstream? Documents and decisions will be promoted to project level." } %>
    <% end %>
  </div>
</div>

<%# Passport strip — the verdict lives on the passport page; this is the summary %>
<% if @passport %>
  <div class="card mb-5">
    <div class="relative px-5 py-3 flex items-center justify-between gap-4 max-lg:flex-wrap">
      <div class="flex items-center gap-5 max-lg:flex-wrap">
        <div class="flex items-baseline gap-1.5">
          <span class="metric text-[22px]"><%= @passport.readiness_score %>%</span>
          <span class="text-text-muted text-[11px]">ready</span>
        </div>
        <%= status_pill("#{@passport.risk_level} Risk", color: @passport.risk_color.to_sym) %>
        <%= status_pill("v#{@passport.current_version || 1}", color: :info) %>
        <span class="text-[12px] text-text-soft">Tests: <span class="font-semibold <%= { 'Passed' => 'text-success', 'Failed' => 'text-danger' }[@passport.test_status] || 'text-text-muted' %>"><%= @passport.test_status %></span></span>
        <% if @passport.human_review_required? %>
          <%= status_pill("Review Required", color: :warning) %>
        <% end %>
      </div>
      <%= link_to "View Passport", run_passport_path(@passport), class: "btn-primary shrink-0" %>
    </div>
  </div>
<% end %>

<%# Sessions + Files Touched %>
<div class="grid grid-cols-[1fr_1fr] gap-4 mb-4 max-xl:grid-cols-1">
  <%= card(title: "Sessions") do %>
    <div class="space-y-2">
      <% @sessions.each do |session| %>
        <%= link_to run_path(session), class: "flex items-center justify-between p-2.5 rounded-md border border-panel-border hover:bg-bg transition-colors no-underline" do %>
          <div class="flex items-center gap-2.5">
            <span class="w-2 h-2 rounded-full <%= session.status == 'active' ? 'bg-success animate-pulse' : 'bg-text-muted' %>"></span>
            <div>
              <p class="text-[12px] font-semibold text-text-primary m-0"><%= session.agent_name %></p>
              <p class="text-[10px] text-text-muted m-0">
                <%= session.started_at&.strftime("%b %d, %H:%M") %>
                <% if session.completed_at %> &middot; <%= ((session.completed_at - session.started_at) / 60).round %> min<% end %>
              </p>
            </div>
          </div>
          <%= status_pill(session.status&.titleize || "Unknown", color: session.status == "active" ? :success : :info) %>
        <% end %>
      <% end %>
      <% if @sessions.empty? %>
        <p class="text-text-muted text-[12px] text-center py-3 m-0">No sessions yet.</p>
      <% end %>
    </div>
  <% end %>

  <%= card(title: "Cumulative Files Touched") do %>
    <% if @files.any? %>
      <div class="space-y-2">
        <% @files.sort_by { |f| -(f["additions"] + f["deletions"]) }.each do |file| %>
          <div class="flex items-center justify-between text-[12px] py-1.5 border-b border-panel-border last:border-0">
            <code class="text-primary text-[11px] truncate max-w-[70%]"><%= file["path"] %></code>
            <div class="flex items-center gap-2 text-[11px] shrink-0">
              <span class="text-success font-semibold">+<%= file["additions"] %></span>
              <span class="text-danger font-semibold">-<%= file["deletions"] %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-text-muted text-[12px] text-center py-3 m-0">No files tracked yet.</p>
    <% end %>
  <% end %>
</div>

<%# Documents & Decisions %>
<div class="grid grid-cols-2 gap-4 max-xl:grid-cols-1">
  <%= card(title: "Documents") do %>
    <% if @documents.any? %>
      <div class="space-y-2">
        <% @documents.each do |doc| %>
          <%= link_to document_path(doc), class: "flex items-center gap-2 p-2 rounded-md hover:bg-bg transition-colors no-underline" do %>
            <span class="inline-flex items-center h-5 px-1.5 rounded text-[9px] font-semibold bg-<%= doc.type_color %>-soft text-<%= doc.type_color %>"><%= doc.document_type.upcase.first(3) %></span>
            <p class="text-[12px] font-semibold text-text-primary m-0 truncate"><%= doc.title %></p>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-text-muted text-[12px] text-center py-3 m-0">No documents generated yet.</p>
    <% end %>
  <% end %>

  <%= card(title: "Decisions") do %>
    <% if @decisions.any? %>
      <div class="space-y-2">
        <% @decisions.each do |log| %>
          <%= link_to decision_log_path(log), class: "flex items-center gap-2 p-2 rounded-md hover:bg-bg transition-colors no-underline" do %>
            <%= status_pill(log.status&.capitalize || "Draft", color: log.status_color.to_sym) %>
            <p class="text-[12px] font-semibold text-text-primary m-0 truncate"><%= log.title %></p>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-text-muted text-[12px] text-center py-3 m-0">No decisions logged yet.</p>
    <% end %>
  <% end %>
</div>

<%# Recent Activity %>
<%= card(title: "Recent Events", classes: "mt-4") do %>
  <div class="space-y-0 max-h-[300px] overflow-y-auto">
    <% @events.each do |event| %>
      <div class="flex items-start gap-2.5 py-2 border-b border-panel-border last:border-0">
        <span class="w-[6px] h-[6px] mt-[6px] rounded-full shrink-0
          <%= case event.event_type
            when /completed/ then 'bg-success'
            when /failed|error/ then 'bg-danger'
            when /edited/ then 'bg-primary'
            else 'bg-text-muted'
          end %>"></span>
        <div class="flex-1 min-w-0">
          <p class="text-[12px] text-text-primary m-0">
            <span class="font-semibold"><%= event.event_type.titleize %></span>
            <% if event.payload["file"] %>
              <code class="text-primary text-[11px] ml-1"><%= File.basename(event.payload["file"]) %></code>
            <% end %>
          </p>
          <p class="text-[10px] text-text-muted mt-0.5 m-0"><%= event.occurred_at.strftime("%b %d, %H:%M:%S") %></p>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
