<h1 class="text-[24px] font-[800] tracking-[-0.04em] mb-5">Edit Workstream</h1>

<%= form_with(model: @workstream, class: "space-y-5 max-w-lg") do |f| %>
  <div>
    <label class="block text-text-soft text-[12px] font-medium mb-1">Title</label>
    <%= f.text_field :title, class: "w-full h-9 px-3 border border-panel-border rounded-md bg-white text-[13px] text-text-primary placeholder:text-text-muted outline-none", placeholder: "Human-readable title for this branch" %>
  </div>
  <div>
    <label class="block text-text-soft text-[12px] font-medium mb-1">Description</label>
    <%= f.text_area :description, rows: 4, class: "w-full p-3 border border-panel-border rounded-md bg-white text-[13px] text-text-soft placeholder:text-text-muted outline-none resize-y", placeholder: "What is this workstream about?" %>
  </div>
  <div>
    <label class="block text-text-soft text-[12px] font-medium mb-1">Status</label>
    <%= f.select :status, Workstream::STATUSES.map { |s| [s.titleize, s] },
      {}, class: "w-full h-9 px-3 border border-panel-border rounded-md bg-white text-[13px] text-text-primary outline-none" %>
  </div>
  <div class="flex gap-3">
    <%= f.submit "Save", class: "h-9 px-5 rounded-md btn-primary text-[12px] font-semibold cursor-pointer border-0" %>
    <%= link_to "Cancel", workstream_path(@workstream), class: "h-9 px-4 rounded-md btn-secondary text-[12px] font-semibold inline-flex items-center no-underline" %>
  </div>
<% end %>
