<h1 class="heading-1 mb-5">Edit Workstream</h1>

<%= form_with(model: @workstream, class: "space-y-5 max-w-lg") do |f| %>
  <div>
    <label class="label">Title</label>
    <%= f.text_field :title, class: "input h-9", placeholder: "Human-readable title for this branch" %>
  </div>
  <div>
    <label class="label">Description</label>
    <%= f.text_area :description, rows: 4, class: "input resize-y", placeholder: "What is this workstream about?" %>
  </div>
  <div>
    <label class="label">Status</label>
    <%= f.select :status, Workstream::STATUSES.map { |s| [s.titleize, s] },
      {}, class: "input h-9" %>
  </div>
  <div class="flex gap-3">
    <%= f.submit "Save", class: "h-9 px-5 rounded-md btn-primary text-[12px] font-semibold cursor-pointer border-0" %>
    <%= link_to "Cancel", workstream_path(@workstream), class: "h-9 px-4 rounded-md btn-secondary text-[12px] font-semibold inline-flex items-center no-underline" %>
  </div>
<% end %>
