<div class="flex justify-between items-start mb-6">
  <div>
    <h1 class="heading-1 mb-2">Run Passports</h1>
    <p class="text-text-muted text-sm">One living Run Passport per workstream, built from captured AI coding sessions.</p>
  </div>
</div>

<div class="space-y-3">
  <% @passports.each do |passport| %>
    <%= link_to run_passport_path(passport), class: "card block no-underline" do %>
      <div class="relative p-5">
        <div class="flex justify-between items-start">
          <div class="flex-1">
            <p class="text-text-primary font-bold mb-1"><%= passport.intent %></p>
            <p class="text-text-muted text-xs mt-1">
              Branch: <span class="text-primary"><%= passport.workstream.branch_name %></span> &middot;
              based on <%= pluralize(passport.sessions_count, "captured session") %>
              <% if (agent = passport.agent_sessions.order(:started_at).last&.agent_name) %>
                (latest: <%= agent %>)
              <% end %> &middot;
              <%= passport.files_count %> files &middot;
              <%= time_ago_in_words(passport.created_at) %> ago
            </p>
          </div>
          <div class="flex items-center gap-4">
            <% if passport.human_review_required? %>
              <span class="text-warning text-xs font-bold">REVIEW NEEDED</span>
            <% end %>
            <%= status_pill(passport.risk_level, color: passport.risk_color.to_sym) %>
            <div class="text-right">
              <span class="metric text-[24px]"><%= passport.readiness_score %>%</span>
              <span class="block text-text-muted text-[11px]">Ready</span>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
