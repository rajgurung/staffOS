<%# AI Council Section %>
<div id="council" class="mt-6">
  <div class="flex items-center justify-between mb-4">
    <div>
      <h2 class="text-[20px] font-[800] tracking-[-0.04em] m-0">AI Council</h2>
      <p class="text-text-muted text-[13px] mt-1 m-0">Multi-persona engineering review of this Run Passport.</p>
    </div>
    <div class="flex items-center gap-3">
      <% if @council_reviews.any? %>
        <% council_cost = @council_reviews.completed.sum(&:cost_cents) %>
        <% if council_cost > 0 %>
          <span class="inline-flex items-center h-[22px] px-2 rounded-md text-[11px] font-semibold bg-bg border border-panel-border text-text-muted"
                title="AI reviewer token cost">
            $<%= format('%.2f', council_cost / 100.0) %>
          </span>
        <% end %>
        <span class="inline-flex items-center h-[22px] px-2 rounded-md text-[11px] font-semibold pill-ready">
          <%= @passport.council_progress %>% complete
        </span>
      <% end %>
      <%= button_to "Run Full Council", run_council_run_passport_path(@passport),
        class: "h-8 px-4 rounded-md btn-primary text-[12px] font-semibold cursor-pointer border-0" %>
    </div>
  </div>

  <%# Agent Grid %>
  <div class="grid grid-cols-6 gap-3 mb-4 max-xl:grid-cols-3 max-lg:grid-cols-2">
    <% CouncilReview::PERSONAS.each do |key, config| %>
      <% review = @council_reviews.find { |r| r.persona == key } %>
      <div class="card <%= review&.completed? ? '' : 'opacity-60' %>">
        <div class="p-4 text-center">
          <div class="w-10 h-10 mx-auto mb-2 rounded-lg bg-<%= config[:color] %>-soft text-<%= config[:color] %> grid place-items-center text-[13px] font-bold">
            <%= config[:icon] %>
          </div>
          <p class="text-[12px] font-semibold text-text-primary m-0"><%= config[:label] %></p>
          <% if review&.completed? %>
            <p class="text-[18px] font-[800] tracking-[-0.04em] mt-1 m-0 <%= review.score >= 7 ? 'text-success' : review.score >= 5 ? 'text-warning' : 'text-danger' %>">
              <%= review.score %>
            </p>
          <% else %>
            <p class="text-text-muted text-[10px] mt-1 m-0">Pending</p>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <% if @council_reviews.any? %>
    <%# Progress Stepper %>
    <div class="card mb-4">
      <div class="relative p-5">
        <p class="text-[12px] font-semibold tracking-[0.02em] uppercase text-text-muted mb-4 m-0">Review Progress</p>
        <div class="relative flex items-start justify-between">
          <%# Track line %>
          <div class="absolute top-[14px] left-[8%] right-[8%] h-[2px] bg-panel-border"></div>
          <% completed_count = @council_reviews.completed.count %>
          <% total = CouncilReview::PERSONAS.count %>
          <% if completed_count > 0 %>
            <div class="absolute top-[14px] left-[8%] h-[2px] bg-success" style="width: <%= ((completed_count.to_f / total) * 84).round %>%"></div>
          <% end %>

          <% CouncilReview::PERSONAS.each_with_index do |(key, config), i| %>
            <% review = @council_reviews.find { |r| r.persona == key } %>
            <div class="relative z-[1] text-center flex-1">
              <div class="w-7 h-7 mx-auto mb-1.5 rounded-full grid place-items-center text-[10px] font-bold
                <%= if review&.completed?
                  'bg-success text-white border-2 border-success'
                elsif review&.running?
                  'bg-white border-[3px] border-primary shadow-[0_0_0_4px_rgba(91,95,247,0.1)]'
                else
                  'bg-white border-2 border-panel-border-strong'
                end %>">
                <% if review&.completed? %>&#10003;<% end %>
              </div>
              <p class="text-[10px] font-semibold text-text-soft m-0 leading-tight"><%= config[:label].split(" ").first %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Council Score Summary %>
    <% if @passport.council_completed? %>
      <div class="card mb-4 border-primary/15">
        <div class="p-5">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-primary-soft text-primary grid place-items-center text-lg font-bold">&#10022;</div>
              <div>
                <p class="text-[15px] font-[800] tracking-[-0.03em] text-text-primary m-0">Council Synthesis</p>
                <p class="text-text-muted text-[12px] m-0">Aggregated recommendation from all reviewers</p>
              </div>
            </div>
            <div class="text-center">
              <p class="text-[28px] font-[850] tracking-[-0.05em] m-0 <%= @passport.council_score >= 7 ? 'text-success' : @passport.council_score >= 5 ? 'text-warning' : 'text-danger' %>">
                <%= @passport.council_score %>
              </p>
              <p class="text-text-muted text-[10px] font-semibold m-0">AVG SCORE</p>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-3 mb-4">
            <% blockers = @council_reviews.completed.sum { |r| (r.findings || []).count { |f| %w[critical high].include?(f["severity"]) } } %>
            <% warnings = @council_reviews.completed.sum { |r| (r.findings || []).count { |f| f["severity"] == "medium" } } %>
            <% positives = @council_reviews.completed.sum { |r| (r.findings || []).count { |f| f["severity"] == "positive" } } %>
            <div class="p-3 rounded-md bg-danger-soft text-center">
              <p class="text-[18px] font-[800] text-danger m-0"><%= blockers %></p>
              <p class="text-text-muted text-[10px] font-semibold m-0">Blockers</p>
            </div>
            <div class="p-3 rounded-md bg-warning-soft text-center">
              <p class="text-[18px] font-[800] text-warning m-0"><%= warnings %></p>
              <p class="text-text-muted text-[10px] font-semibold m-0">Warnings</p>
            </div>
            <div class="p-3 rounded-md bg-success-soft text-center">
              <p class="text-[18px] font-[800] text-success m-0"><%= positives %></p>
              <p class="text-text-muted text-[10px] font-semibold m-0">Positives</p>
            </div>
          </div>

          <%# Overall recommendation %>
          <div class="p-3 rounded-md bg-bg border border-panel-border">
            <p class="text-[12px] font-semibold text-text-muted mb-1 m-0">OVERALL RECOMMENDATION</p>
            <p class="text-[13px] text-text-primary leading-[1.6] m-0">
              <% if blockers > 0 %>
                <strong class="text-danger">Do not merge.</strong> <%= blockers %> blocker(s) identified across council reviews. Address critical findings before proceeding.
              <% elsif warnings > 2 %>
                <strong class="text-warning">Merge with caution.</strong> <%= warnings %> warning(s) raised. Review findings and address before or immediately after merge.
              <% else %>
                <strong class="text-success">Approve for merge.</strong> Council review passed. Minor items noted for follow-up.
              <% end %>
            </p>
          </div>
        </div>
      </div>
    <% end %>

    <%# Individual Review Cards %>
    <div class="grid grid-cols-2 gap-4 max-xl:grid-cols-1">
      <% @council_reviews.completed.ordered.each do |review| %>
        <div class="card">
          <div class="p-5">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-<%= review.color %>-soft text-<%= review.color %> grid place-items-center text-[11px] font-bold">
                  <%= review.icon %>
                </div>
                <div>
                  <p class="text-[13px] font-semibold text-text-primary m-0"><%= review.label %></p>
                  <p class="text-text-muted text-[10px] m-0">
                    <%= review.completed_at&.strftime("%H:%M") %>
                    &middot;
                    <% if review.source == "llm" %>
                      <span title="<%= review.model %>"><%= review.model %></span>
                    <% else %>
                      <span title="Deterministic StaffOS heuristics">Heuristic</span>
                    <% end %>
                  </p>
                </div>
              </div>
              <span class="text-[20px] font-[800] tracking-[-0.04em] <%= review.score >= 7 ? 'text-success' : review.score >= 5 ? 'text-warning' : 'text-danger' %>">
                <%= review.score %>
              </span>
            </div>

            <%# Recommendation %>
            <p class="text-[13px] text-text-soft leading-[1.6] mb-3 m-0"><%= review.recommendation %></p>

            <%# Findings %>
            <% if review.findings.present? %>
              <div class="space-y-2">
                <% review.findings.each do |finding| %>
                  <div class="flex items-start gap-2 text-[12px]">
                    <span class="w-[6px] h-[6px] mt-[6px] rounded-full shrink-0
                      <%= case finding['severity']
                        when 'critical' then 'bg-danger'
                        when 'high' then 'bg-danger'
                        when 'medium' then 'bg-warning'
                        when 'positive' then 'bg-success'
                        else 'bg-text-muted'
                      end %>"></span>
                    <span class="text-text-soft leading-[1.5]"><%= finding["detail"] %></span>
                  </div>
                <% end %>
              </div>
            <% end %>

            <%# Risk assessment %>
            <div class="mt-3 pt-3 border-t border-panel-border">
              <p class="text-[11px] text-text-muted leading-[1.5] m-0"><%= review.risk_assessment %></p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
