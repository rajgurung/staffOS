<%# Page Header %>
<div class="flex justify-between items-start mb-4 max-lg:flex-col max-lg:gap-4">
  <div>
    <h1 class="heading-1 mb-1">
      Run Passport <%= status_pill("v#{@passport.current_version || 1}", color: :info) %>
    </h1>
    <p class="text-text-muted text-[13px]">
      Living assessment of <%= link_to @passport.workstream.branch_name, workstream_path(@passport.workstream), class: "text-primary font-semibold no-underline" %>
      &middot; based on <%= pluralize(@passport.sessions_count, "captured session") %>
      &middot; updated <%= time_ago_in_words(@passport.updated_at) %> ago
    </p>
  </div>

  <div class="flex gap-2">
    <div data-controller="clipboard" data-clipboard-text-value="Run Passport #<%= @passport.id %> | <%= @passport.risk_level %> Risk | <%= @passport.readiness_score %>% Ready | <%= @passport.intent %>">
      <button data-action="clipboard#copy" class="h-8 px-3 btn-secondary rounded-md text-[12px] font-semibold cursor-pointer">Share</button>
    </div>
    <%= link_to "Export", export_run_passport_path(@passport, format: :md), class: "h-8 px-3 btn-secondary rounded-md text-[12px] font-semibold inline-flex items-center no-underline" %>
    <%= link_to "JSON", export_run_passport_path(@passport, format: :json), class: "h-8 px-3 btn-secondary rounded-md text-[12px] font-semibold inline-flex items-center no-underline" %>
  </div>
</div>

<%# Review Mode Selector %>
<div class="flex items-center gap-2 mb-6">
  <span class="text-text-muted text-[11px] font-semibold uppercase tracking-[0.04em]">Review Mode:</span>
  <% RunPassport::REVIEW_MODES.each do |mode| %>
    <% active = (@passport.review_mode || "passive") == mode %>
    <%= button_to set_review_mode_run_passport_path(@passport, mode: mode),
      class: "h-7 px-3 rounded-md text-[11px] font-semibold border-0 cursor-pointer transition-all #{active ? 'bg-primary text-white shadow-primary' : 'bg-bg-wash text-text-soft hover:bg-panel-border'}",
      method: :post do %>
      <%= mode.titleize.gsub("_", " ") %>
    <% end %>
  <% end %>
  <span class="text-text-muted text-[11px] ml-2"><%= @passport.review_mode_description %></span>
</div>

<%# Metric Cards %>
<div class="grid grid-cols-5 gap-4 mb-4 max-xl:grid-cols-2 max-lg:grid-cols-1">
  <%= card(title: "PR Readiness", classes: "min-h-[146px] card-accent-success") do %>
    <div class="readiness-ring w-[104px] h-[104px] mx-auto mb-2.5 grid place-items-center rounded-full">
      <span class="metric text-[28px]"><%= @passport.readiness_score %>%</span>
    </div>
    <p class="text-text-muted text-[13px] text-center">Based on <%= pluralize(@passport.sessions_count, "captured session") %>. <%= @passport.missing_checks&.length || 0 %> checks need attention.</p>
  <% end %>

  <%= card(title: "Risk Level", classes: "min-h-[146px] card-accent-warning") do %>
    <p class="mt-2 metric text-[32px] <%= risk_color(@passport.risk_level) %>"><%= @passport.risk_level %></p>
    <% top_check = (@passport.missing_checks || []).find { |c| c["severity"] == "high" } %>
    <% if top_check %>
      <p class="text-text-muted text-[13px]"><%= truncate(top_check["check"], length: 90) %></p>
    <% end %>
  <% end %>

  <%= card(title: "Tests", classes: "min-h-[146px] card-accent-teal") do %>
    <p class="mt-2 metric text-[32px] <%= { 'Passed' => 'text-success', 'Failed' => 'text-danger' }[@passport.test_status] || 'text-text-muted' %>"><%= @passport.test_status %></p>
    <p class="text-text-muted text-[13px]">
      <% if @passport.test_summary.present? %>
        <%= @passport.test_summary["total"] %> examples, <%= @passport.test_summary["failed"] %> failures. <%= @passport.test_summary["new_tests"] %> new tests.
      <% end %>
    </p>
  <% end %>

  <%= card(title: "Files Changed", classes: "min-h-[146px] card-accent-blue") do %>
    <p class="mt-2 metric text-[32px] text-primary">
      <%= @passport.files_count %> <span class="text-[14px] font-semibold text-text-muted">Files</span>
    </p>
    <p class="text-text-muted text-[13px]">+<%= @passport.total_additions %> additions, -<%= @passport.total_deletions %> deletions</p>
    <% if (coverage = @passport.branch_coverage).present? %>
      <% gap = coverage["unobserved_paths"].to_a.size %>
      <%= tag.p class: "text-[13px] mt-1 #{gap.zero? ? 'text-success' : 'text-warning'}",
                title: (gap.positive? ? "Unobserved: #{coverage['unobserved_paths'].join(', ')}" : nil) do %>
        Branch coverage: <%= coverage["observed"] %> of <%= coverage["branch_files"] %> branch files observed by sessions
      <% end %>
    <% end %>
  <% end %>

  <%= card(title: "Human Review", classes: "min-h-[146px] card-accent-purple") do %>
    <p class="mt-2 metric text-[32px] <%= @passport.human_review_required? ? 'text-warning' : 'text-success' %>">
      <%= @passport.human_review_required? ? "Required" : "Accepted" %>
    </p>
    <% if @passport.human_review_required? %>
      <% high = (@passport.missing_checks || []).count { |c| c["severity"] == "high" } %>
      <% if high > 0 %>
        <p class="text-text-muted text-[13px]"><%= pluralize(high, "high-severity check") %> outstanding.</p>
      <% end %>
    <% else %>
      <p class="text-text-muted text-[13px]">No high-risk changes detected.</p>
    <% end %>
  <% end %>
</div>

<%# AI Council — the reviewer's verdict, front and centre %>
<%= render "council" %>

<%# Version Timeline %>
<%= card(title: "Version Timeline", classes: "mt-4 mb-4") do %>
  <% if @versions.any? %>
    <div class="space-y-3">
      <% @versions.each do |version| %>
        <div class="p-3 rounded-md border border-panel-border <%= version == @versions.first ? 'bg-primary-soft/50 border-primary/10' : 'bg-bg/50' %>">
          <div class="flex items-center justify-between mb-1">
            <div class="flex items-center gap-2">
              <span class="text-[13px] font-[700]">v<%= version.version_number %></span>
              <%= status_pill(version.risk_level, color: version.risk_color.to_sym) %>
              <% delta = version.readiness_delta %>
              <% if delta && delta != 0 %>
                <span class="text-[11px] font-semibold <%= delta > 0 ? 'text-success' : 'text-danger' %>">
                  <%= delta > 0 ? "+#{delta}" : delta %>%
                </span>
              <% end %>
            </div>
            <span class="metric text-[18px]"><%= version.readiness_score %>%</span>
          </div>
          <p class="text-text-muted text-[11px] m-0">
            <% if version.agent_session %>
              Session: <%= link_to version.agent_session.agent_name, run_path(version.agent_session), class: "font-semibold text-primary no-underline hover:underline" %>
              &middot; <%= version.agent_session.started_at&.strftime("%b %d, %H:%M") %>
              <% if version.duration_minutes %>&middot; <%= version.duration_minutes %> min<% end %>
            <% else %>
              <%= version.trigger.titleize %> &middot; no session
            <% end %>
            &middot; <%= version.created_at.strftime("%b %d, %H:%M") %>
          </p>
          <% if version.changes_from_previous.present? %>
            <p class="text-text-soft text-[11px] mt-1 m-0"><%= version.changes_from_previous %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-text-muted text-[13px] text-center py-4 m-0">No versions recorded yet. Versions are created when sessions complete or reviews run.</p>
  <% end %>
<% end %>

<%# Bottom Row %>
<div class="grid grid-cols-[1.4fr_1fr_1fr] gap-4 max-xl:grid-cols-1">
  <%= card(title: "AI Summary") do %>
    <p class="text-text-soft text-sm leading-[1.7]"><%= @passport.summary %></p>
  <% end %>

  <%= card(title: "Reviewer Checklist") do %>
    <div class="flex flex-col gap-[13px]">
      <% (@passport.recommended_actions || []).each do |action| %>
        <div class="grid grid-cols-[18px_1fr_auto] gap-2.5 items-center text-text-soft text-[13px]">
          <span class="w-4 h-4 border border-panel-border rounded"></span>
          <span><%= action["action"] %></span>
          <span class="<%= action['priority'] == 'high' ? 'text-danger' : action['priority'] == 'medium' ? 'text-warning' : 'text-success' %> text-xs font-bold uppercase"><%= action["priority"] %></span>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= card(title: "Generate Documentation") do %>
    <div class="flex flex-col gap-2.5 text-[13px]">
      <div class="flex items-center justify-between p-3 rounded-md bg-primary-soft border border-primary/10">
        <div>
          <p class="font-semibold text-text-primary m-0">ADR Draft</p>
          <p class="text-text-muted text-[11px] mt-0.5 m-0">Architecture decision record from this session.</p>
        </div>
        <%= button_to "Generate", generate_document_run_passport_path(@passport, doc_type: "adr"), class: "h-7 px-3 rounded-md btn-primary text-[11px] font-semibold border-0 cursor-pointer shrink-0" %>
      </div>
      <div class="flex items-center justify-between p-3 rounded-md bg-blue-soft border border-blue/10">
        <div>
          <p class="font-semibold text-text-primary m-0">Decision Log</p>
          <p class="text-text-muted text-[11px] mt-0.5 m-0">Structured decision record with rationale.</p>
        </div>
        <%= button_to "Generate", generate_document_run_passport_path(@passport, doc_type: "decision_log"), class: "h-7 px-3 rounded-md btn-primary text-[11px] font-semibold border-0 cursor-pointer shrink-0" %>
      </div>
      <div class="flex items-center justify-between p-3 rounded-md bg-success-soft border border-success/10">
        <div>
          <p class="font-semibold text-text-primary m-0">PR Summary</p>
          <p class="text-text-muted text-[11px] mt-0.5 m-0">Ready-to-paste pull request description.</p>
        </div>
        <%= button_to "Generate", generate_document_run_passport_path(@passport, doc_type: "pr_summary"), class: "h-7 px-3 rounded-md btn-primary text-[11px] font-semibold border-0 cursor-pointer shrink-0" %>
      </div>
      <div class="flex items-center justify-between p-3 rounded-md bg-warning-soft border border-warning/10">
        <div>
          <p class="font-semibold text-text-primary m-0">Project Memory</p>
          <p class="text-text-muted text-[11px] mt-0.5 m-0">Save key context for future sessions.</p>
        </div>
        <%= button_to "Save", generate_document_run_passport_path(@passport, doc_type: "memory"), class: "h-7 px-3 rounded-md btn-primary text-[11px] font-semibold border-0 cursor-pointer shrink-0" %>
      </div>
    </div>
  <% end %>
</div>
