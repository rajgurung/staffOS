<%= form_with(model: document, class: "space-y-6") do |f| %>
  <% if document.errors.any? %>
    <div class="p-4 rounded-sm bg-danger-soft border border-danger/20 text-danger text-sm">
      <% document.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>
  <div>
    <label class="label">Type</label>
    <%= f.select :document_type, Document::TYPES.map { |t| [t.titleize, t] },
      {}, class: "input h-11" %>
  </div>
  <div>
    <label class="label">Title</label>
    <%= f.text_field :title, class: "input h-11", placeholder: "Document title..." %>
  </div>
  <div>
    <label class="label">Content (Markdown)</label>
    <%= f.text_area :content_markdown, rows: 15, class: "input font-mono resize-y", placeholder: "Write your document content..." %>
  </div>
  <div>
    <label class="label">Status</label>
    <%= f.select :status, %w[draft published archived].map { |s| [s.capitalize, s] },
      {}, class: "input h-11" %>
  </div>
  <div class="flex gap-3">
    <%= f.submit class: "h-[42px] px-6 rounded-sm btn-primary font-bold cursor-pointer border-0" %>
    <%= link_to "Cancel", documents_path, class: "btn-secondary btn-lg" %>
  </div>
<% end %>
