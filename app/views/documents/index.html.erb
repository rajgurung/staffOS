<div class="flex justify-between items-start mb-6">
  <div>
    <h1 class="text-[24px] font-[800] tracking-[-0.04em] mb-1">Project Documentation</h1>
    <p class="text-text-muted text-[13px]">Knowledge promoted from merged workstreams, plus project-level docs.</p>
  </div>
  <%= link_to "New Document", new_document_path, class: "h-8 px-3 rounded-md btn-primary text-[12px] font-semibold cursor-pointer border-0 inline-flex items-center no-underline" %>
</div>

<div class="flex gap-2 mb-5">
  <% [["All", nil], ["ADRs", "adr"], ["PR Summaries", "pr_summary"], ["Risk Items", "risk_item"]].each do |label, type| %>
    <% active = params[:type] == type || (type.nil? && params[:type].blank?) %>
    <%= link_to label, documents_path(type: type),
      class: "h-8 px-3 flex items-center rounded-md text-[12px] font-semibold transition-colors no-underline #{active ? 'bg-primary text-white shadow-primary' : 'btn-secondary'}" %>
  <% end %>
</div>

<div class="space-y-2">
  <% @documents.each do |doc| %>
    <%= link_to document_path(doc), class: "card card-hover block no-underline" do %>
      <div class="relative p-4">
        <div class="flex justify-between items-center">
          <div class="flex items-center gap-2.5 min-w-0 flex-1">
            <span class="inline-flex items-center h-5 px-1.5 rounded text-[9px] font-semibold shrink-0 bg-<%= doc.type_color %>-soft text-<%= doc.type_color %>"><%= doc.document_type.upcase.first(3) %></span>
            <div class="min-w-0">
              <p class="text-[13px] font-semibold text-text-primary m-0 truncate"><%= doc.title %></p>
              <p class="text-[11px] text-text-muted mt-0.5 m-0">
                <%= doc.project.name %>
                <% if doc.workstream %>&middot; <code class="text-primary text-[10px]"><%= doc.workstream.branch_name %></code><% end %>
                &middot; <%= time_ago_in_words(doc.created_at) %> ago
              </p>
            </div>
          </div>
          <span class="text-text-muted text-[11px] font-medium shrink-0"><%= doc.status&.capitalize || "Draft" %></span>
        </div>
      </div>
    <% end %>
  <% end %>
  <% if @documents.empty? %>
    <div class="text-center py-12 text-text-muted">
      <p class="font-semibold mb-1">No project-level documents yet</p>
      <p class="text-[13px]">Documents are generated within workstreams and promoted here when the branch merges.</p>
    </div>
  <% end %>
</div>
