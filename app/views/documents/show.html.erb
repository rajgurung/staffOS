<div class="flex justify-between items-start mb-6">
  <div>
    <div class="flex items-center gap-3 mb-2">
      <span class="inline-flex items-center h-7 px-3 rounded-full text-xs font-bold bg-<%= @document.type_color %>-soft text-<%= @document.type_color %>"><%= @document.type_label %></span>
      <span class="text-text-muted text-sm"><%= @document.status&.capitalize || "Draft" %></span>
    </div>
    <h1 class="text-[30px] font-[800] leading-tight tracking-[-0.05em] mb-2"><%= @document.title %></h1>
    <p class="text-text-muted text-sm">
      <%= @document.project.name %> &middot; Created <%= time_ago_in_words(@document.created_at) %> ago
    </p>
  </div>
  <div class="flex gap-3">
    <%= link_to "Edit", edit_document_path(@document), class: "h-[42px] px-4 border border-panel-border rounded-sm bg-white text-text-primary font-bold inline-flex items-center no-underline hover:bg-bg" %>
    <%= link_to "Delete", document_path(@document), data: { turbo_method: :delete, turbo_confirm: "Delete this document?" }, class: "h-[42px] px-4 border border-danger/20 rounded-sm bg-danger-soft text-danger font-bold inline-flex items-center no-underline hover:bg-danger/10" %>
  </div>
</div>

<%= card do %>
  <div class="text-text-soft leading-[1.8]"><%= simple_format(@document.content_markdown) %></div>
<% end %>
