<div class="max-w-2xl mx-auto">
  <div class="text-center mb-8">
    <div class="w-14 h-14 mx-auto mb-4 rounded-xl bg-gradient-to-br from-primary to-purple grid place-items-center text-white text-xl font-bold shadow-primary">S</div>
    <h1 class="heading-1 mb-2">Connect a Project</h1>
    <p class="text-text-soft text-[14px]">Two steps to capture your Claude Code work, branch by branch.</p>
  </div>

  <% if @project && @token %>
    <%# Step 1: Copy your token %>
    <div class="card card-accent-warning mb-4">
      <div class="p-6">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-6 h-6 rounded-full bg-warning text-white grid place-items-center text-[11px] font-bold">1</span>
          <h2 class="text-[15px] font-[700] m-0">Copy your API token</h2>
        </div>
        <p class="text-text-muted text-[12px] mb-3 m-0">This is your personal token for <strong><%= @project.name %></strong>. Keep it secret.</p>
        <div class="relative" data-controller="clipboard" data-clipboard-text-value="<%= @token.token %>">
          <div class="p-3 rounded-lg bg-bg border border-panel-border font-mono text-[13px] text-text-primary break-all">
            <%= @token.token %>
          </div>
          <button data-action="clipboard#copy" class="absolute top-2 right-2 h-7 px-2.5 rounded-md bg-warning text-white text-[11px] font-semibold border-0 cursor-pointer hover:bg-warning/80 transition-colors">Copy Token</button>
        </div>
      </div>
    </div>

    <%# Step 2: Install the CLI and connect the repo %>
    <div class="card card-accent-primary mb-4">
      <div class="p-6">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-6 h-6 rounded-full bg-primary text-white grid place-items-center text-[11px] font-bold">2</span>
          <h2 class="text-[15px] font-[700] m-0">Install the CLI and connect your repo</h2>
        </div>
        <div class="relative" data-controller="clipboard" data-clipboard-text-value="brew install rajgurung/tap/staffos">
          <div class="terminal p-4 rounded-lg text-[13px] overflow-x-auto">
            <span class="terminal-dim">$</span> brew install rajgurung/tap/staffos
          </div>
          <button data-action="clipboard#copy" class="absolute top-3 right-3 h-7 px-2.5 rounded-md bg-white/10 text-white/70 text-[11px] font-semibold border-0 cursor-pointer hover:bg-white/20 transition-colors">Copy</button>
        </div>
        <div class="relative mt-2" data-controller="clipboard" data-clipboard-text-value="staffos init">
          <div class="terminal p-4 rounded-lg text-[13px] overflow-x-auto">
            <span class="terminal-dim">$</span> cd your-repo &amp;&amp; staffos init
          </div>
          <button data-action="clipboard#copy" class="absolute top-3 right-3 h-7 px-2.5 rounded-md bg-white/10 text-white/70 text-[11px] font-semibold border-0 cursor-pointer hover:bg-white/20 transition-colors">Copy</button>
        </div>
        <div class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-[12px] text-text-muted" data-controller="clipboard" data-clipboard-text-value="<%= request.base_url %>">
          <span>When <code>init</code> asks for the endpoint, use</span>
          <code class="text-primary"><%= request.base_url %></code>
          <button data-action="clipboard#copy" class="h-6 px-2 rounded-md btn-secondary text-[11px] font-semibold cursor-pointer">Copy</button>
        </div>
        <p class="text-text-muted text-[12px] mt-2 m-0">Then paste the token from step 1. <code>init</code> saves it in <code>.staffos.yml</code> and installs the Claude Code hooks in <code>.claude/settings.local.json</code>. Both stay out of git. Restart Claude Code in the repo afterwards.</p>
      </div>
    </div>

    <%# What happens %>
    <div class="card mb-4">
      <div class="p-6">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-6 h-6 rounded-full bg-success text-white grid place-items-center text-[11px] font-bold">3</span>
          <h2 class="text-[15px] font-[700] m-0">Use Claude Code normally</h2>
        </div>
        <div class="space-y-3">
          <% [
            ["Session starts", "StaffOS creates a workstream for your Git branch", "primary"],
            ["You work", "File reads, edits, commands — all captured as events", "blue"],
            ["Claude replies", "Your branch passport is rebuilt with risk score and recommendations", "purple"],
            ["Review", "Run the AI Council, generate docs, export PR summaries", "orange"]
          ].each_with_index do |(title, desc, color), i| %>
            <div class="flex items-start gap-3 p-3 rounded-lg bg-bg">
              <span class="w-8 h-8 rounded-lg bg-<%= color %>-soft text-<%= color %> grid place-items-center text-[11px] font-bold shrink-0"><%= i + 1 %></span>
              <div>
                <p class="text-[13px] font-semibold text-text-primary m-0"><%= title %></p>
                <p class="text-[12px] text-text-muted m-0"><%= desc %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# How the pieces fit together %>
    <div class="card mb-4">
      <div class="p-6">
        <h2 class="text-[13px] font-semibold tracking-[0.02em] uppercase text-text-muted mb-4 m-0">How It Fits Together</h2>
        <%= render "shared/concept_diagram" %>
      </div>
    </div>

    <%# Connection details %>
    <div class="card mb-4">
      <div class="p-6">
        <h2 class="text-[13px] font-semibold tracking-[0.02em] uppercase text-text-muted mb-4 m-0">Connection Details</h2>
        <div class="space-y-2.5 text-[13px]">
          <div class="flex justify-between"><span class="text-text-muted">Project</span><span class="font-semibold"><%= @project.name %></span></div>
          <div class="flex justify-between"><span class="text-text-muted">Endpoint</span><code class="text-primary text-[12px]"><%= request.base_url %></code></div>
          <div class="flex justify-between"><span class="text-text-muted">Token</span><code class="text-text-soft text-[12px]"><%= @token.masked_token %></code></div>
          <div class="flex justify-between"><span class="text-text-muted">Hooks</span><span class="font-semibold">SessionStart, Prompt, Pre/PostToolUse, Stop</span></div>
          <div class="flex justify-between"><span class="text-text-muted">Privacy</span><span class="text-success font-semibold">Source code stays local</span></div>
        </div>
      </div>
    </div>

    <%# Manual alternative %>
    <details class="card">
      <summary class="p-4 cursor-pointer text-[13px] font-semibold text-text-soft hover:text-text-primary">
        Manual setup (without <code>staffos init</code>)
      </summary>
      <div class="px-6 pb-6 text-[12px] text-text-soft space-y-3">
        <p class="m-0">Install the CLI as above. The hooks need it to add the git branch to each event.</p>
        <p class="m-0">Then copy the hook config from the <a href="<%= hook_config_project_path(@project) %>" class="text-primary no-underline font-semibold">hook config page</a> into <code>.claude/settings.local.json</code>.</p>
      </div>
    </details>
  <% else %>
    <div class="card p-6 text-center">
      <p class="text-text-muted">Select a project from the topbar dropdown first.</p>
    </div>
  <% end %>
</div>
