<div class="flex justify-between items-start mb-6">
  <div>
    <h1 class="heading-1 mb-2">Runs</h1>
    <p class="text-text-muted text-sm">All AI coding sessions captured by StaffOS.</p>
  </div>
</div>

<div class="flex gap-3 mb-6">
  <% %w[all active completed].each do |status| %>
    <% active = (params[:status] == status) || (status == "all" && params[:status].blank?) %>
    <%= link_to status.capitalize,
      runs_path(status: status == "all" ? nil : status),
      class: "h-9 px-4 flex items-center rounded-sm text-sm font-bold transition-colors no-underline #{active ? 'btn-primary border-0' : 'border border-panel-border bg-panel-solid text-text-soft hover:bg-bg'}" %>
  <% end %>
</div>

<div class="space-y-3">
  <% @sessions.each do |session| %>
    <%= link_to run_path(session), class: "card block no-underline" do %>
      <div class="relative p-5">
        <div class="flex justify-between items-center">
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-1">
              <span class="text-text-primary font-bold"><%= session.agent_name %></span>
              <%= status_pill(session.status&.capitalize || "Unknown", color: session.status == "completed" ? :success : :info) %>
            </div>
            <p class="text-text-muted text-xs">
              Branch: <span class="text-primary"><%= session.branch_name %></span>
              &middot; <%= session.project.name %>
              &middot; Started <%= time_ago_in_words(session.started_at) %> ago
            </p>
          </div>
          <% passport = session.workstream&.run_passport %>
          <% if passport %>
            <div class="flex items-center gap-4">
              <span class="text-[11px] text-text-muted">based on <%= pluralize(passport.sessions_count, "captured session") %></span>
              <%= status_pill(passport.risk_level, color: passport.risk_color.to_sym) %>
              <span class="metric text-[18px]"><%= passport.readiness_score %>%</span>
            </div>
          <% else %>
            <span class="text-text-muted">&mdash;</span>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
