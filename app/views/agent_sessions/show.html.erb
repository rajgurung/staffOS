<div class="flex justify-between items-start mb-6">
  <div>
    <h1 class="text-[30px] font-[800] leading-tight tracking-[-0.05em] mb-2">
      Run: <%= @session.agent_name %>
      <%= status_pill(@session.status&.capitalize || "Active", color: @session.status == "completed" ? :success : :info) %>
    </h1>
    <p class="text-text-muted text-sm">
      Branch: <span class="text-primary"><%= @session.branch_name %></span>
      &middot; <%= @session.project.name %>
      &middot; Started <%= time_ago_in_words(@session.started_at) %> ago
    </p>
  </div>
</div>

<% if @passport %>
  <%= link_to run_passport_path(@passport), class: "card block no-underline mb-6" do %>
    <div class="relative p-5 flex justify-between items-center gap-4">
      <div>
        <p class="text-[13px] font-[800] m-0">
          Contributed to the <span class="text-primary"><%= @session.workstream.branch_name %></span> passport
        </p>
        <p class="text-text-muted text-xs mt-1">
          Based on <%= pluralize(@passport.sessions_count, "captured session") %> &middot; Full readiness detail lives on the passport
        </p>
      </div>
      <div class="flex items-center gap-4 shrink-0">
        <% if @passport.risk_level.present? %>
          <%= status_pill(@passport.risk_level, color: @passport.risk_color.to_sym) %>
        <% end %>
        <span class="text-lg font-[850] tracking-[-0.05em]"><%= @passport.readiness_score %>%</span>
      </div>
    </div>
  <% end %>
<% else %>
  <p class="text-text-muted text-sm mb-6">No passport applies to this session (unknown branch).</p>
<% end %>

<div class="grid grid-cols-3 gap-4 mb-6 max-xl:grid-cols-1">
  <%= card(title: "Session Info") do %>
    <div class="space-y-3 text-sm">
      <div class="flex justify-between"><span class="text-text-muted">Provider</span><span class="font-semibold"><%= @session.provider %></span></div>
      <div class="flex justify-between"><span class="text-text-muted">Agent</span><span class="font-semibold"><%= @session.agent_name %></span></div>
      <div class="flex justify-between"><span class="text-text-muted">Branch</span><span class="text-primary font-semibold"><%= @session.branch_name %></span></div>
      <div class="flex justify-between"><span class="text-text-muted">Started</span><span><%= @session.started_at&.strftime("%Y-%m-%d %H:%M") %></span></div>
      <div class="flex justify-between"><span class="text-text-muted">Completed</span><span><%= @session.completed_at&.strftime("%Y-%m-%d %H:%M") || "In progress" %></span></div>
      <% if @session.metadata.present? %>
        <div class="flex justify-between"><span class="text-text-muted">Model</span><span class="text-purple font-semibold"><%= @session.metadata["model"] %></span></div>
        <div class="flex justify-between"><span class="text-text-muted">Tokens</span><span><%= number_with_delimiter(@session.metadata["tokens_used"]) %></span></div>
      <% end %>
    </div>
  <% end %>

  <%= card(title: "Event Timeline", classes: "col-span-2 max-h-[500px] overflow-y-auto") do %>
    <div class="flex flex-col gap-[18px]">
      <% @events.each do |event| %>
        <div class="grid grid-cols-[74px_18px_1fr] gap-3 items-start">
          <span class="text-text-muted text-xs"><%= event.occurred_at.strftime("%H:%M:%S") %></span>
          <span class="w-3 h-3 mt-[3px] rounded-full
            <%= case event.event_type
              when /completed|command_run/ then 'bg-success'
              when /failed|error/ then 'bg-danger'
              else 'bg-primary'
            end %>"></span>
          <div>
            <p class="text-[13px] font-[800] m-0"><%= event.event_type.titleize %></p>
            <p class="text-text-muted text-xs mt-1">
              <% if event.payload["file"] %><code class="text-primary"><%= event.payload["file"] %></code><% end %>
              <% if event.payload["command"] %><code class="text-purple"><%= event.payload["command"] %></code><% end %>
              <% if event.payload["prompt"] %><%= truncate(event.payload["prompt"], length: 120) %><% end %>
            </p>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
